@using Allgem01.Logic
@using Microsoft.AspNetCore.Components.Routing // Import the namespace for RouteView
@using Allgem01.Components.Layout // Ensure the namespace for MainLayout is correct
@inject Repository repository
@layout MainLayout
@namespace Allgem01.Components

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Allgem01.styles.css" />
    <link rel="icon" type="image/png" href="all_icon.png" />
    <HeadOutlet />
</head>

<body>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="@typeof(MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <h1>Page not found</h1>
        </NotFound>
    </Router>
    <script src="_framework/blazor.web.js"></script>
    <script>
        window.methods = {
            CreateCookie: function (name, value, seconds) {
                var expires;
                if (seconds) {
                    var date = new Date();
                    date.setTime(date.getTime() + (seconds * 1000)); // Convert seconds to milliseconds
                    expires = "; expires=" + date.toUTCString();
                } else {
                    expires = "";
                }
                document.cookie = encodeURIComponent(name) + "=" + encodeURIComponent(value) + expires + "; path=/";
            }
        }
    </script>
    <script>
        function getCookie(name) {
            const value = `; ${document.cookie}`;
            const parts = value.split(`; ${encodeURIComponent(name)}=`);
            if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
            return null;
        }
    </script>
    <script>
        function deleteCookie(name) {
            document.cookie = encodeURIComponent(name) + "=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
        }
    </script>
</body>
</html>

@code {
    public bool SignedIn => repository.IsLoggedIn;
    public bool Premium => repository.hasPremium;

    public void SetSignedIn(bool trueOrFalse)
    {
        repository.SetLoggedIn(trueOrFalse);
    }
    public void SetPremium(bool tof)
    {
        repository.SetHasPremium(tof);
    }
}