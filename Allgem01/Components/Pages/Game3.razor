@page "/shooting/play"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allgem</title>
</head>
</html>


<header><strong>ALLGEM</strong>
    <li><button class="home" type=".button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type=".button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type=".button" @onclick="contactusFf">Contact Us</button></li>
</header>

<section class="downheader"></section>

<section class="lowersection">
    <div class="cards">
    <button class="play" type=".button" @onclick="game2Ff">
<button class="start">
  START
</button>
        <p class="tip"></p>
        </button>
    </div>
</section>


<style>
    header {
        background: rgb(10, 13, 20);
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 20px 40px 10px 50px;
        border: none;
        border-radius: none;
        
    }
    .downheader {
        background: rgb(31, 33, 48);
        height: 2px;
        width: 100%;
        display: flex;
        justify-content: center;
    }
    li{
        display: inline-block;
        list-style-type: none;
        padding-right: 40px;

    }
    .home{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 70px;
        height: 35px;
        margin-left: 900px;
    }
    .aboutus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 90px;
        height: 35px;
    }
    .contactus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 103px;
        height: 35px;
    }
    .lowersection {
        display: flex;
        justify-content: center;
        height: 761px;
        width: 100%;
        background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
    }
.cards {
  display: flex;
  flex-direction: row;
  gap: 15px;
  margin-top: 213px
}
.play {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  text-align: center;
  height: 250px;
  width: 500px;
  border-radius: 10px;
  color: white;
  cursor: pointer;
  transition: 400ms;
  background-color: rgb(0, 0, 0);
  transition: color, 500ms;
  transition: transform,border-radius, 3s;
  transition: border-radius,box-shadow, 2s;
}

.play p.tip {
  font-size: 1em;
  font-weight: 700;
}
.play:hover {
  transform: scale(1.01, 1.01);
  box-shadow: 0px 0px 30px 1px rgba(0, 78, 247, 0.493);
  border-radius: 20px;
}
/*.play:focus {
    transform: scale(3.55,3.45 );
    color: rgb(36, 32, 33);
    border-radius: 10px;
}*/
.start {
  background-color: #004fece7;
  color: white;
  font-size: 16px;
  font-weight: bold;
  padding: 15px 20px;
  border-radius: 2em;
  cursor: pointer;
  transition: 0.1s ease;
  border-width: 0;
  box-shadow: 1px 5px 0 0 #0e285d;
  pointer-events: none;
}
</style>

@code {

    //Navigation between pages
    private void homeFf()
    {
        NavigationManager.NavigateTo("/");
    }
    private void aboutusFf()
    {
        NavigationManager.NavigateTo("/about-us");
    }
    private void contactusFf()
    {
        NavigationManager.NavigateTo("/contact-us");
    }
    private void game2Ff()
    {
        //Thread.Sleep(1500);
        NavigationManager.NavigateTo("/");
        var url = "https://sqenzy.github.io/fpsgamet/";
        if (JSRuntime != null)
        {
            JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }
}
