@code {
    private string? CookieValue;
    private string? CookieValue1;
    private string? CookieValueEmail;
    private string? CookieValueRank;
    private string rankimg = "/bronze.png";
    

    private bool dik = true;
private GameLoad Load;
private string iframeUrl;
private string GameName;
private string Description;
private string imageUrl;
private string gameid;

private string lgpgame;
private string lgpimg;
private string previousGameId;
private string previousGameImg;
private bool isLoading = true;

[Parameter]
[SupplyParameterFromQuery(Name = "g")]
public string? GameParameter { get; set; }

protected override async Task OnInitializedAsync()
{
    await base.OnInitializedAsync();

    // Load current game data
    if (!string.IsNullOrEmpty(GameParameter))
    {
        Load = Allgem01.Components.Pages.Games.GameLoad.LoadById(GameParameter);
        if (Load != null)
        {
            iframeUrl = Load.url;
            GameName = Load.name;
            Description = Load.description;
            imageUrl = Load.imageUrl;
            gameid = Load.id;
        }
    }

    // Show the last played game image and keep it showing
    await LoadAndDisplayLastPlayedGame();
}

protected override async Task OnParametersSetAsync()
{
    await base.OnParametersSetAsync();
    
    // Reload game data when parameters change (e.g., when navigating to a different game)
    if (!string.IsNullOrEmpty(GameParameter))
    {
        Load = Allgem01.Components.Pages.Games.GameLoad.LoadById(GameParameter);
        if (Load != null)
        {
            iframeUrl = Load.url;
            GameName = Load.name;
            Description = Load.description;
            imageUrl = Load.imageUrl;
            gameid = Load.id;
            
            // If we have a previous game stored, update the button to show it
            if (!string.IsNullOrEmpty(previousGameId) && !string.IsNullOrEmpty(previousGameImg))
            {
                lgpgame = previousGameId;
                lgpimg = previousGameImg;
            }
            
            StateHasChanged(); // Force UI update
        }
    }
}

private async Task LoadAndDisplayLastPlayedGame()
{
    // Get the last played game from storage
    var lastGameId = await GetLastPlayedGameId();
    
    if (!string.IsNullOrEmpty(lastGameId))
    {
        var lastGame = GameLoad.LoadById(lastGameId);
        if (lastGame != null)
        {
            // Set the display to show last played game
            lgpimg = string.IsNullOrEmpty(lastGame.imageUrl) ? "/defaultimg.png" : lastGame.imageUrl;
            lgpgame = lastGame.id;
            
            StateHasChanged(); // Update UI with last game image
            
            // Wait for the last game image to load
            await WaitForImageLoad(lgpimg);
            
            // After image loads, update the storage variable to current game
            // but keep displaying the last game image
            await UpdateStorageToCurrentGame();
        }
        else
        {
            // No valid last game, show default and set current game
            lgpimg = "/defaultimg.png";
            lgpgame = "";
            StateHasChanged();
            await UpdateStorageToCurrentGame();
        }
    }
    else
    {
        // No last game, show default and set current game
        lgpimg = "/defaultimg.png";
        lgpgame = "";
        StateHasChanged();
        await UpdateStorageToCurrentGame();
    }
}

private async Task UpdateStorageToCurrentGame()
{
    // Update the stored "last played game" to the current game
    // but don't change what's displayed in #g3
    if (Load != null)
    {
        await SetLastPlayedGameId(Load.id);
        // Note: We don't update lgpimg here - it keeps showing the previous game
    }
}

private async Task WaitForImageLoad(string imageUrl)
{
    try
    {
        await JSRuntime.InvokeVoidAsync("waitForImageLoad", imageUrl);
    }
    catch
    {
        // Fallback to time delay if JS fails
        await Task.Delay(1500);
    }
}

// Storage methods using localStorage
[Inject] IJSRuntime JSRuntime { get; set; }

private async Task<string> GetLastPlayedGameId()
{
    try
    {
        return await JSRuntime.InvokeAsync<string>("localStorage.getItem", "lastPlayedGameId");
    }
    catch
    {
        return null;
    }
}

private async Task SetLastPlayedGameId(string gameId)
{
    try
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "lastPlayedGameId", gameId);
    }
    catch
    {
        // Handle error silently
    }
}
