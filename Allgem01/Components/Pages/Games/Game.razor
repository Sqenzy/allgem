@page "/game"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Allgem01.Logic
@inject Repository repository

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@GameName - Play on Allgem Games</title>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1918445686655465"
     crossorigin="anonymous"></script>
    <meta name="description" content="@Description">
    <link rel="preload" as="image" href="/ulteros.jpg">
</head>
</html>

@if (isLoading)
{
    <div class="loading-container" id="loadingContainer">
        <img src="/allgemtext.png" alt="ALLGEM" class="logo">
        <div class="loading-spinner"></div>
        <div class="loading-text">Loading...</div>
    </div>
}
<style>
  .loading-container {
    background: rgb(10, 13, 20);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 30px;
    width: 100vw;
    height: 100vh;
    z-index: 10000;
    position: fixed;
    top: 0;
    left: 0;
    background-size: cover;
    background-position: center;
  }
  .loading-spinner {
    border: 8px solid #f3f3f3;
    border-top: 8px solid #3498db;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    animation: spin 1s linear infinite;
    margin: 0 auto;
  }
  .logo {
    width: 200px;
    height: auto;
    margin-top: 200px;
  }
  .loading-text {
    font-size: 18px;
    font-weight: bold;
    color: white;
    margin-top: 20px;
    opacity: 0.8;
  }
</style>



<header class="@(isExpanded ? "hide-header" : "")">
  @if (repository.IsLoggedIn)
    {
      
      @if (repository.hasPremium)
      {
        <img @onclick="homeFf" class="logopremium" src="/allgempremium.png" alt="ALLGEM PREMIUM">
        <img class="lpu">
      }
      else
      {
        <img @onclick="homeFf" class="logo" src="/allgemtext.png" alt="ALLGEM">   
      }
    }
    else
    {
      <img @onclick="homeFf" class="logo" src="/allgemtext.png" alt="ALLGEM">
    }
    <button class="mobileprofile" @onclick="MobileProfile" type="button">
      <img class="profileimg" src="/profile.png" alt="profile">
      </button>
    <nav>
    <li><button class="home" type="button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type="button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type="button" @onclick="contactusFf">Contact Us</button></li>
@if (repository.IsLoggedIn)
    {
      <button class="profile"  @onclick="accountFf" type="button">
          <img class="profileimg" src="/profile.png" alt="profile">
      </button>
      @if (profile == true)
      {
        <div class="profilemenu">
          <button class="logout" @onclick="Logout">Log Out</button>
        </div>
      }
      else{

      }
      @if (repository.hasPremium)
      {
      }
      else
      {
          
      }
    }
    else
    {
        <button class="login" @onclick="loginFf">
          <p class="lgtxt">LogIn</p>
          </button>
    }
    </nav>
</header>

<section class="downheader"></section>

<section class="lowersection">
<div class="sidebar sidebar-right">
    <button class="sidebar-btn"><img src=""></button>
    <button class="sidebar-btn"></button>
    <button class="sidebar-btn"></button>
</div>
    <div class="game-container">
        <div class="iframe-container">
            <iframe src="@iframeUrl" 
                    frameborder="0" 
                    allowfullscreen 
                    class="@(isExpanded ? "iframe-expanded" : "")">
            </iframe>
            @if (isExpanded)
            {
                <button class="closeexpand" @onclick="closeexpand"></button>
            }
        </div>
        <section class="titlesection">
    <div class="titlebar">
        <span class="title">@GameName</span>
        @if (!isExpanded)
        {
            <button class="expand" @onclick="Expand"></button>
        }
    </div>
</section>
    </div>
</section>
<section class="description">
  <div class="des">
  <h3>Description</h3>
  <p>@Description</p>
  </div>
</section>

<footer><p>© 2025 Allgem</p><button class="tc" @onclick="termFf">Terms & conditions</button><button class="dd" @onclick="devFf">Developer Panel</button>
</footer>

<script>
// Get the button
let mybutton = document.getElementById("myBtn");

// When the user scrolls down 20px from the top of the document, show the button
window.onscroll = function() {scrollFunction()};

function scrollFunction() {
  if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
    mybutton.style.display = "block";
  } else {
    mybutton.style.display = "none";
  }
}

// When the user clicks on the button, scroll to the top of the document
function topFunction() {
  document.body.scrollTop = 0;
  document.documentElement.scrollTop = 0;
}
</script>

