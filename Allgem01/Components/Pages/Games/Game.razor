@code {
    private string? CookieValue;
    private string? CookieValue1;
    private string? CookieValueEmail;
    private string? CookieValueRank;
    private bool dik = true;
    private GameLoad Load;
    private string iframeUrl;
    private string GameName;
    private string Description;
    private string imageUrl;
    private bool isLoading = true;

    [Parameter]
    [SupplyParameterFromQuery(Name = "g")]
    public string? GameParameter { get; set; }




    protected override void OnInitialized()
    {

        if (!string.IsNullOrEmpty(GameParameter))
    {
        Load = Allgem01.Components.Pages.Games.GameLoad.LoadById(GameParameter);
        if (Load != null)
        {
            iframeUrl = Load.url;
            GameName = Load.name;
            Description = Load.description;
            imageUrl = Load.imageUrl;
        }
    }
        base.OnInitialized();
    }

    private bool profile = false;

    private void MobileProfile()
    {
        if (repository.IsLoggedIn)
        {
          NavigationManager.NavigateTo("/account");
        }
        else
        {
          NavigationManager.NavigateTo("/login");
        }
    }

    private void accountFf()
    {
        NavigationManager.NavigateTo("/account");
    }

    private void loginFf()
    {
      NavigationManager.NavigateTo("/login");
    }

    private void homeFf()
    {
        NavigationManager.NavigateTo("/");
    }

    private void aboutusFf()
    {
        NavigationManager.NavigateTo("/about-us");
    }

    private void contactusFf()
    {
        NavigationManager.NavigateTo("/contact-us");
    }

    private void devFf()
    {
        NavigationManager.NavigateTo("/developer-panel");
    }

    private void termFf()
    {
        NavigationManager.NavigateTo("/terms-and-conditions");
    }

    private bool isExpanded = false;

    private void Expand()
    {
        isExpanded = !isExpanded;
    }
    private void closeexpand()
    {
        isExpanded = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Read the cookie values
            CookieValue = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_auth");
            CookieValue1 = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_premium");
            CookieValueEmail = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_email");
            CookieValueRank = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_rank");

            // Update the authentication state based on the cookie value
            if (CookieValue == "isli")
            {
                repository.SetLoggedIn(true);
            }
            else
            {
                repository.SetLoggedIn(false);
            }

            if (CookieValue1 == "hsp")
            {
                repository.SetHasPremium(true);
            }
            else
            {
                repository.SetHasPremium(false);
            }

            StateHasChanged();
            await JSRuntime.InvokeVoidAsync("topFunction");

            if (repository.IsLoggedIn)
            {
                dik = true;
                _ = RankosAsync();
            }
            else
            {
                dik = false;
            }
        }
    }

    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_auth");
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_premium");
        repository.SetLoggedIn(false);
        NavigationManager.NavigateTo("/");
    }

    private async Task RankosAsync()
    {
        if (CookieValueRank == "Silver")
        {
            repository.rankCount = 5;
        }
        else if (CookieValueRank == "Gold")
        {
            repository.rankCount = 15;
        }
        else if (CookieValueRank == "Platinum")
        {
            repository.rankCount = 60;
        }
        else if (CookieValueRank == "Diamond")
        {
            repository.rankCount = 180;
        }
        else if (CookieValueRank == "Dev")
        {
        repository.rankCount = 1000;
        }
        else
        {
            repository.rankCount = 0;
        }

        while (dik)
        {
            await Task.Delay(60000);
            repository.rankCount++;

            if (repository.rankCount == 5)
            {
                repository.AddRankToUser(CookieValueEmail, "Silver");
            }
            else if (repository.rankCount == 15)
            {
                repository.AddRankToUser(CookieValueEmail, "Gold");
            }
            else if (repository.rankCount == 60)
            {
                repository.AddRankToUser(CookieValueEmail, "Platinum");
            }
            else if (repository.rankCount == 180)
            {
                repository.AddRankToUser(CookieValueEmail, "Diamond");
            }
        }
    }
