@code {
    private string? email;
    private string? password;
    private bool showInfo = false;

    int genNumber;
    int? code = null;

    private void loginFf()
    {
        NavigationManager.NavigateTo("/login");
    }

    private async Task signUp()
    {

        if (string.IsNullOrEmpty(email))
        {
            // Handle the case where email is null or empty
            await JSRuntime.InvokeVoidAsync("alert", "Please input an email.");
            return;
        }

        if (string.IsNullOrEmpty(password))
        {
            // Handle the case where password is null or empty
            await JSRuntime.InvokeVoidAsync("alert", "Please input a password.");
            return;
        }
        showInfo = true;


        Random random = new Random();
        int generatedNumber = random.Next(100000, 999999);
        genNumber = generatedNumber;


var client = new SmtpClient("live.smtp.mailtrap.io", 587)
{
    Credentials = new NetworkCredential("api", "648356e75b69975053832541c5ff1f49"),
    EnableSsl = true
};
client.Send("hello@demomailtrap.co", "petr.prusa36@gmail.com", "Email Verification", generatedNumber.ToString());
System.Console.WriteLine("Sent");


}
private void putintodb()
{
    if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(password))
    {
        JSRuntime.InvokeVoidAsync("alert", "Email and password cannot be empty.");
        return;
    }
    if (code == null)
    {
        JSRuntime.InvokeVoidAsync("alert", "You need to verify your email.");
        return;
    }
    if (genNumber == code)
    {
        repository.SignUp(email, password);
        NavigationManager.NavigateTo("/login");
    }
    else if (genNumber != code)
    {
        JSRuntime.InvokeVoidAsync("alert", "Verification code is incorrect.");
    }
    else
    {
        JSRuntime.InvokeVoidAsync("alert", "Verification code is incorrect.");
    }
}
}