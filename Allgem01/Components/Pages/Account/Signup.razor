@page "/signup"
@using Allgem01.Logic
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject Repository repository
@inject IJSRuntime JSRuntime

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up</title>
</head>
<body>
    
</body>
</html>

<section class="boxsection">
    <p class="tg">Create Account</p>
    <input id="p1" placeholder="Enter your nickname/email" type="text" @bind="email">
    <input id="p2" placeholder="Enter your password" type="password" @bind="password">
    <button class="signup" @onclick="putintodb">Create Account</button>
    <p class="ptxt">By creating an account, you agree to the</p>
    <button class="tc" @onclick="tcFf">Terms & conditions</button>
    <button class="loginnav" @onclick="loginFf">Already have an account?</button>
</section>

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        margin: 0;
        padding: 20px;
        background: linear-gradient(90deg, #0066cc 0%, #1a4d80 50%, #0066cc 100%);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    .boxsection {
        width: 100%;
        max-width: 480px;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 24px;
        padding: 40px 30px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        position: relative;
    }

    .tg {
        color: white;
        font-size: clamp(24px, 5vw, 32px);
        font-weight: 600;
        text-align: center;
        margin-bottom: 30px;
    }

    #p1, #p2 {
        width: 100%;
        height: 54px;
        background-color: rgba(255, 255, 255, 0.1);
        color: white;
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 12px;
        padding: 0 18px;
        font-size: 16px;
        margin-bottom: 16px;
        transition: all 0.3s ease;
    }

    #p1::placeholder, #p2::placeholder {
        color: rgba(255, 255, 255, 0.6);
    }

    #p1:hover, #p2:hover {
        border-color: rgba(255, 255, 255, 0.4);
        background-color: rgba(255, 255, 255, 0.15);
    }

    #p1:focus, #p2:focus {
        outline: none;
        border-color: rgba(255, 255, 255, 0.6);
        background-color: rgba(255, 255, 255, 0.15);
        box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
    }

    .signup {
        width: 100%;
        height: 54px;
        margin-top: 10px;
        margin-bottom: 20px;
        color: white;
        background: linear-gradient(135deg, #0052cc, #0066ff);
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 102, 204, 0.4);
    }

    .signup:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0, 102, 204, 0.6);
        background: linear-gradient(135deg, #0047b3, #0052cc);
    }

    .signup:active {
        transform: translateY(0);
    }

    .ptxt {
        color: rgba(255, 255, 255, 0.8);
        font-size: 13px;
        text-align: center;
        display: inline;
    }

    .tc {
        background: none;
        color: white;
        font-size: 13px;
        padding: 0;
        border: none;
        cursor: pointer;
        display: inline;
        text-decoration: underline;
        margin-left: 4px;
        transition: opacity 0.2s ease;
    }

    .tc:hover {
        opacity: 0.8;
    }

    .terms-container {
        text-align: center;
        margin-bottom: 20px;
    }

    .loginnav {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        display: block;
        width: 100%;
        height: 48px;
        transition: all 0.3s ease;
        color: white;
        font-size: 15px;
        font-weight: 500;
        cursor: pointer;
        margin-top: 10px;
    }

    .loginnav:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
        border-color: rgba(255, 255, 255, 0.2);
    }

    @@media (max-width: 600px) {
        .boxsection {
            padding: 30px 20px;
            border-radius: 20px;
        }

        #p1, #p2, .signup, .loginnav {
            height: 50px;
        }

        .tg {
            margin-bottom: 25px;
        }
    }

    @@media (max-width: 400px) {
        body {
            padding: 15px;
        }

        .boxsection {
            padding: 25px 18px;
        }

        .ptxt, .tc {
            font-size: 12px;
        }
    }
</style>

@code {
    private string? email;
    private string? password;

    private void loginFf()
    {
        NavigationManager.NavigateTo("/login");
    }

    private void tcFf()
    {
        NavigationManager.NavigateTo("/terms-and-conditions");
    }

    private async Task putintodb()
    {
        if (string.IsNullOrEmpty(email))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please enter your email.");
            return;
        }

        if (string.IsNullOrEmpty(password))
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please enter your password.");
            return;
        }

        try
        {
            repository.SignUp(email, password);
            repository.AddRankToUser(email, "Bronze");
            await CreateCookie("allgem_email", email, 2592000);
            await CreateCookie("allgem_auth", "isli", 2592000);
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"An error occurred: {ex.Message}");
        }
    }

    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }

    private async Task CreateCookie(string name, string value, int days)
    {
        await JSRuntime.InvokeAsync<string>("methods.CreateCookie", name, value, days);
    }
}