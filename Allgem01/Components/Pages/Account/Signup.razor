<section class="boxsection">
        <p class="tg">Create Account</p>
        <input id="p1" placeholder="Enter your email" type="email" @bind="email">
        <input id="p2" placeholder="Enter your password" type="password" @bind="password">
        <input id="p3" placeholder="Enter your verification code" type="number" @bind="code">
        <button class="verify"@onclick="async () => await signUp()">Verify Mail</button>
        @if (showInfo)
{
    <div class="info">! We have sent your a verification code to <strong>@email</strong></div>
}
<button class="signup"@onclick="putintodb">Create Account</button>
<button class="loginnav" @onclick="loginFf">Already have an account?</button>
</section>


