@page "/signup"
@using Allgem01.Logic
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject Repository repository
@inject IJSRuntime JSRuntime
@using System.Net;
@using System.Net.Mail;
@using RestSharp;

