@page "/login"
@using Allgem01.Logic
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject Repository repository
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.Components.Authorization;
@using Microsoft.AspNetCore.Authentication.OAuth.Claims;
@using Microsoft.AspNetCore.Authentication;
@using Microsoft.AspNetCore.Authentication.Cookies;
@using System.Security.Claims;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log In</title>
</head>
<body>
    
</body>
</html>

<section class="boxsection">
        <input id="p1" placeholder="Enter your email" type="email" @bind="email">
        <input id="p2" placeholder="Enter your password" type="password" @bind="password">
        <button class="login" @onclick="logIn">Log In</button>
        <button class="signupnav" @onclick="signupFf">Don't have an account?</button>
</section>



<style>

    body {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
    }
    .boxsection {
        width: 550px; /* Set width */
        height: 400px; /* Set height */
        background-color: rgb(55, 56, 82);
        position: absolute;
        top: 260px;
        border-radius: 48px;
        left: 700px;
    }
    #p1{
         border-radius: 12px;
        width: 470px;
        height: 50px;     
        position: absolute;
        left: 50%;
        transform: translate(-50%, -50%);
        margin-top: 80px;
    }
    #p2{
        border-radius: 12px;
        position: absolute;
        left: 50%;
        transform: translate(-50%, -50%);
        margin-top: 180px;
        width: 470px;
        height: 50px; 
    }
    .login {
  background: rgb(10, 13, 20);
  box-sizing: border-box;
  border: 0;
  border-radius: 20px;
  padding: 1em 1.8em;
  display: flex;
  transition: 0.2s all;
  align-items: center;
  gap: 0.6em;
  font-weight: bold;
  margin-top: 290px;
  margin-left: 200px;
  color: white;
}

.login:hover {
   background: rgb(15, 21, 36);
   transform: translateY(-3px);
}
.signupnav{
  background: rgb(10, 13, 20);
  box-sizing: border-box;
  border: 0;
  border-radius: 20px;
  padding: 1em 1.8em;
  display: flex;
  transition: 0.2s all;
  align-items: center;
  gap: 0.6em;
  font-weight: bold;
  margin-top: 290px;
  margin-left: 200px;
  color: white;
}
.signupnav:hover {
   background: rgb(15, 21, 36);
   transform: translateY(-3px);
}
</style>
@code {
    private string? email;
    private string? password;

    private void signupFf()
    {
      NavigationManager.NavigateTo("/signup");
    }

    private void logIn()
    {
        if (string.IsNullOrEmpty(email))
        {
            // Handle the case where email is null or empty
            JSRuntime.InvokeVoidAsync("alert", "Please input an email.");
            return;
        }

        if (string.IsNullOrEmpty(password))
        {
            // Handle the case where password is null or empty
            JSRuntime.InvokeVoidAsync("alert", "Please input a password.");
            return;
        }

        if (repository.Login(email, password))
        {
            CreateCookie("allgem_auth", "isli", 15);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            JSRuntime.InvokeVoidAsync("alert", "Invalid email or password.");
        }
    }
    private async void CreateCookie ( string name, string value, int days ) 
    { 
        var test = await JSRuntime.InvokeAsync<string>("methods.CreateCookie", name, value, days); 
    }
}