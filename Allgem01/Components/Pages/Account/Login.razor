@page "/login"
@using Allgem01.Logic
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject Repository repository
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.Components.Authorization;
@using Microsoft.AspNetCore.Authentication.OAuth.Claims;
@using Microsoft.AspNetCore.Authentication;
@using Microsoft.AspNetCore.Authentication.Cookies;
@using System.Security.Claims;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log In</title>
</head>
<body>
    
</body>
</html>

<section class="boxsection">
        <input id="p1" placeholder="Enter your email" type="email" @bind="email">
        <input id="p2" placeholder="Enter your password" type="password" @bind="password">
        <button class="login" @onclick="logIn">
            <p class="lgtxt">Log In</p><p class="txt"> ›</p>
            </button>
        <button class="signupnav" @onclick="signupFf">
            <p class="dnt">Don't have an account?</p>
            <p class="crt">Create Account</p>
        </button>
</section>



<style>

    body {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
    }
    .boxsection {
        width: 550px; /* Set width */
        height: 400px; /* Set height */
        background-color: rgb(55, 56, 82);
        position: absolute;
        top: 260px;
        border-radius: 48px;
        left: 700px;
    }
    #p1{
         border-radius: 12px;
        width: 470px;
        height: 50px;     
        position: absolute;
        left: 50%;
        transform: translate(-50%, -50%);
        margin-top: 80px;
    }
    #p2{
        border-radius: 12px;
        position: absolute;
        left: 50%;
        transform: translate(-50%, -50%);
        margin-top: 180px;
        width: 470px;
        height: 50px; 
    }
    .login {
  background: rgb(28, 75, 185);
  border: 0;
  margin-left: 220px;
  border-radius: 18px;
  transition: 0.01s outline;
  color: white;
  height: 50px;
  width: 120px;
  display: flex;
  margin-top: 300px;
}
.login:hover{
  outline: 2px rgb(202, 203, 206) solid;
}
.txt{
  margin-left: 9px;
  margin-top: 13px;
  transition: 0.25s all;
}
.login:hover .txt{
  margin-left: 20px;
  font-size: 150%;
  margin-top: 5px;
}
.lgtxt {
  margin-left: 27px;
  margin-top: 13px;
  font-weight: bold;
}
.signupnav{
  background: none;
  box-sizing: border-box;
  border: 0;
  border-radius: 20px;
  padding: 1em 1.8em;
  display: flex;
  transition: 0.2s all;
  align-items: center;
  gap: 0.6em;
  font-weight: bold;
  margin-top: 20px;
  margin-left: 190px;
}
.signupnav:hover {
   background: rgb(15, 21, 36);
}
.signupnav:hover .crt {
    font-size: 16px;
    margin-top: 0px;
    margin-left: 0px;
}
.signupnav .crt{
    font-size: 0px;
    color: white;
    transition: 0.3s all;
    margin-top: 30px;
    margin-left: 40px;
}
.signupnav .dnt{
    color: white;
    font-size: 12px;
    position: absolute;
    transition: 0.3s all;
}
.signupnav:hover .dnt{
    margin-top: -30px;
    margin-left: 65px;
    transform: translateY(-10px);
    font-size: 0px;
}
</style>
@code {
    private string? email;
    private string? password;

    private void signupFf()
    {
      NavigationManager.NavigateTo("/signup");
    }

    private void logIn()
    {
        if (string.IsNullOrEmpty(email))
        {
            // Handle the case where email is null or empty
            JSRuntime.InvokeVoidAsync("alert", "Please input an email.");
            return;
        }

        if (string.IsNullOrEmpty(password))
        {
            // Handle the case where password is null or empty
            JSRuntime.InvokeVoidAsync("alert", "Please input a password.");
            return;
        }

        if (repository.Login(email, password))
        {
            CreateCookie("allgem_auth", "isli", 15);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            JSRuntime.InvokeVoidAsync("alert", "Invalid email or password.");
        }
    }
    private async void CreateCookie ( string name, string value, int days ) 
    { 
        var test = await JSRuntime.InvokeAsync<string>("methods.CreateCookie", name, value, days); 
    }
}