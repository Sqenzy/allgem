@page "/logout"
@rendermode InteractiveServer
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@using Allgem01.Logic
@inject Repository repository





@code {
    protected override async Task OnInitializedAsync()
    {
        await PerformLogoutAsync();
    }

    private async Task PerformLogoutAsync()
    {
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_auth");
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_premium");
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_rank");
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_email");
        await JSRuntime.InvokeVoidAsync("deleteCookie", "acm");
        await JSRuntime.InvokeVoidAsync("deleteCookie", "dev_gn");
    
            repository.SetHasPremium(false);

        repository.SetLoggedIn(false);
        NavigationManager.NavigateTo("/");
    }
}