<header>
  @if (repository.IsLoggedIn)
    {
      @if (repository.rank == "Dev")
      {
        <input id="1" placeholder="Enter email" type="email" @bind="email">
        <button @onclick="buyPremium">Buy Premium</button>
        <button @onclick="rmPremium">Remove Premium</button>
        <select id="2" @bind="repository.rank">
          <option value="" disabled selected>Select Rank</option>
          <option value="Bronze">Bronze</option>
