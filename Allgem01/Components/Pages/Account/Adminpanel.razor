@page "/adminpanel"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Allgem01.Logic
@inject Repository repository

@namespace Allgem01.Components.Pages.Account

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel</title>
</head>
@if (repository.IsLoggedIn)
{
    if (repository.rank == "Dev")
    {
        <section class="imgsection"> 
            <img src="adminpanel.webp">
        </section>

        <section class="panelsection">
            <section class="panel">
                <section class="asection">
                    <h1 class="Premium">Premium</h1>
                    <button class="set" value="add" @onclick="AddPremium">Add</button>
                    <button class="remove" value="remove" @onclick="RemovePremium">Remove</button>
                    <div class="glass-radio-group">
                        <input type="radio" name="plan" id="glass-bronze" @onclick="Bronze"/>
                        <label for="glass-bronze">Bronze</label>
                        <input type="radio" name="plan" id="glass-silver" @onclick="Silver"/>
                        <label for="glass-silver">Silver</label>
                        <input type="radio" name="plan" id="glass-gold" @onclick="Gold"/>
                        <label for="glass-gold">Gold</label>
                        <input type="radio" name="plan" id="glass-platinum" @onclick="Platinum"/>
                        <label for="glass-platinum">Platinum</label>
                        <input type="radio" name="plan" id="glass-diamond" @onclick="Diamond"/>
                        <label for="glass-diamond">Diamond</label>
                        <input type="radio" name="plan" id="glass-staff" @onclick="Admin"/>
                        <label for="glass-staff">Admin</label>
                        <input type="radio" name="plan" id="glass-testing" @onclick="Testing"/>
                        <label for="glass-testing">Testing</label>
                        <input type="radio" name="plan" id="glass-developer" @onclick="Developer"/>
                        <label for="glass-developer">Developer</label>
                    </div>
                </section>
                <section class="bsection">
                    <input class="email" type="text" placeholder="enter email" @bind="email">
                    <input class="password" type="text" placeholder="enter password" @bind="newpassword">
                </section>
                <section class="csection">
                    <button class="savechanges">save changes</button>
                    <div class="changesinfo">
                        <h5>Changes Info</h5>
                        <a>@email</a>
                        <a>@newpassword</a>
                        <a>@newrank</a>
                        <a>@premiumstatus</a>
                    </div>
                </section>
                <section class="dsection">
                    <h1 class="GameManagement">Game Management</h1>
                    <button class="addgame" @onclick="AddGame">Add New Game</button>
                    <button class="viewgames" @onclick="ViewGames">View All Games</button>
                </section>
            </section>
        </section>
    }
    else
    {
        <p>You do not have permission to view this page.</p>
    }
}
else
{
    <p>Please log in to access the admin panel.</p>
}

