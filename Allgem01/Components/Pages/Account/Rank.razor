@page "/account/rank"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Allgem01.Logic
@inject Repository repository

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account</title>
    <style>
  header{
    visibility: hidden;
}
.logo{
    visibility: hidden;
}
body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: rgba(10, 13, 20, 0.95);
      overflow-x: hidden;
    }
</style>
<link rel="stylesheet" href="header.css">
<link rel="stylesheet" href="loading.css">
</head>
</html>
<style>
    @@keyframes spin {
    0% { transform: rotate(0deg);}
    100% { transform: rotate(360deg);}
}

@@keyframes spinReverse {
    0% { transform: rotate(360deg);}
    100% { transform: rotate(0deg);}
}

@@keyframes dots {
    0%   { content: ""; }
    33%  { content: "."; }
    66%  { content: ".."; }
    100% { content: "..."; }
}
</style>

@if (isLoading)
{
    <div class="loading-overlay">
        <div class="loading-spinner"></div>
        <span style="color:white;">Loading...</span>
    </div>
}

<header>
     <section class="logosection">
       @if (!repository.hasPremium)
        {
          <img class="logo" src="/allgemtext.webp" alt="logo" href="/" @onclick="homeFf">
        }
        else if (CookieValueRank == "Dev")
        {
          <img class="logodev" src="/allgemdeveloper.webp" alt="devlogo" @onclick="adminFf">
          <img class="lpudev">
        }
        else
        {
          <img class="logopremium" src="/allgempremium.webp" alt="premiumlogo" href="/" @onclick="homeFf">
          <img class="lpu">
        }
        @if (CookieValue == "isli")
        {
          <div class="nlrank-div" href="/account">
          </div>
        }
        else
        {
          <div class="nlrank-div" href="/account"></div>
        }
      </section>
      <nav>
      <a class="changelog" href="/"><img class="backarrow" src="/backarrow.webp">Home</a>
      <a class="aboutus" href="https://allgemgames.featurebase.app/en/help/articles/6890206-about-allgem">About Us</a>
      <a class="support" href="https://allgemgames.featurebase.app/en/help/articles/1547414-how-to-contact-support">Support</a>
      @if (CookieValue == "isli")
        {
          <img class="account" src="profile.webp" href="/account"/>
        }
        else
        {
          <a class="login" href="/login"><p class="lgtxt">Login</p></a>
        }
      </nav>
</header>

<section class="sidebar-left">
<div class="sidebar-links">
<a href="/account">Account</a>
<a href="/account/rank">Rank</a>
<a>Premium</a>
<p class="logout" @onclick="Logout">Logout</p>
</div>
</section>

<div class="kjl">
<div class="cnm">
<p class="email">@CookieValueRank</p>
<p class="line">_________________</p>
<div class="info">
<img class="rankguide" src="/rankimages/rankguide.webp"/>
</div>
</div>
</div>
