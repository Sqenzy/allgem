@page "/contact-us"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us</title>
</head>
</html>



<header><strong>ALLGEM</strong>
    <li><button class="home" type="button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type="button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type="button" @onclick="contactusFf">Contact Us</button></li>
</header>

<section class="downheader"></section>

<section class="lowersection">
    <button class="discordinvite" @onclick="DiscordInvite">Discord</button>
    <button class="email" @onclick="OpenMailClient">Email</button>
    <div class="blue-box"></div>
</section>


<style>
    header {
        background: linear-gradient(90deg, rgb(0, 195, 255), blue, rgb(0, 2, 102));
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 20px 40px 10px 50px;
        border: none;
        border-radius: none;
    }
    .downheader {
        background: linear-gradient(90deg,  rgb(12, 15, 160), rgb(0, 80, 133), rgb(0, 80, 133), rgb(1, 100, 146), rgb(0, 80, 133), rgb(0, 80, 133), rgb(12, 15, 160));
        height: 2px;
        width: 100%;
        display: flex;
        justify-content: center;
    }
    li {
        display: inline-block;
        list-style-type: none;
        padding-right: 40px;

    }
    .home{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 0;
        border: none;
        border-radius: 8px;
        width: 70px;
        height: 35px;
        margin-left: 900px;
    }
    .aboutus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 0;
        border: none;
        border-radius: 8px;
        width: 90px;
        height: 35px;
    }
    .contactus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 0;
        border: none;
        border-radius: 8px;
        width: 103px;
        height: 35px;
    }
        .discordinvite{
        background: rgb(128, 128, 128);
        background-size: 300% 300%;
        color: rgb(0, 0, 0);
        font-size: 33px;
        padding: 0;
        border: none;
        border-radius: 48px;
        width: 270px;
        height: 65px;
        margin-top: 9%;
        margin-right: 10px;
    }
    .email{
        background: rgb(255, 255, 255);
        background-size: 300% 300%;
        color: rgb(0, 0, 0);
        font-size: 33px;
        padding: 0;
        border: none;
        border-radius: 48px;
        width: 270px;
        height: 65px;
        margin-top: 9%;
    }
    .blue-box {
    width: 600px; /* Set width */
    height: 400px; /* Set height */
    background-color: #0047AB; /* Blue color */
    position: absolute;
    top: 60%;
    left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 48px;
    }
    .lowersection {
        display: flex;
        justify-content: center;
        height: 1000px;
        width: 100%;
        background: linear-gradient(90deg, rgb(0, 1, 61), rgb(0, 75, 145), rgb(0, 100, 146), rgb(2, 132, 192), rgb(0, 100, 146), rgb(0, 75, 145), rgb(0, 1, 61));
    }
</style>

@code {

    //Navigation between pages
    private void playGameSecurityIDM()
    {
        NavigationManager.NavigateTo("SecurityIDM");
    }
    private void homeFf()
    {
        NavigationManager.NavigateTo("/");
    }
    private void aboutusFf()
    {
        NavigationManager.NavigateTo("/about-us");
    }
    private void contactusFf()
    {
        NavigationManager.NavigateTo("/contact-us");
    }
<!--email automatization-->

    private void OpenMailClient()
    {
        var url = "https://mail.google.com/mail/u/0/?tab=rm&ogbl#inbox?compose=DmwnWtDnGmKzPzPLcPKblqLXJQQTXQmgZxqpSjTDdFBCQCxBKscKRqbxMddkdWrtzCwNBCHBrCml";
        if (JSRuntime != null)
        {
            JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }


<!--discord invite autmatization-->
    private void DiscordInvite()
    {
        var url = "https://discord.gg/MZp9j6NKrR";
        if (JSRuntime != null)
        {
            JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }
}
