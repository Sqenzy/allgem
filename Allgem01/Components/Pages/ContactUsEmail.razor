@page "/contact-us"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us</title>
</head>
</html>



<header><strong>ALLGEM</strong>
    <li><button class="home" type="button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type="button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type="button" @onclick="contactusFf">Contact Us</button></li>
</header>

<section class="downheader"></section>

<section class="downheader1"></section>

<section class="lowersection">
    <button class="discordinvite" @onclick="DiscordInvite">Discord</button>
    <button class="email" @onclick="OpenMailClient">Email</button>
</section>
<section class="formsection">
    <div class="blue-box">
        <form action="https://formsubmit.co/36e6b93cb26f8ec08611000a741650f4" method="POST">
            <input class="name" type="text" name="name" required placeholder="Name">
            <input class="email" type="email" name="email" required placeholder="Email">
            <input type="text" class="message" name="message" required placeholder="Message">
            <input type="hidden" name="_captcha" value="false">
            <!--<input type="hidden" name="_cc" value="janlukavsky65@gmail.com"> >-->
            <input type="hidden" name="_next" value="http://localhost:5224/">
            <button class="submit" type="submit" @onclick="thanks">Submit</button>
        </form>
    </div>
</section>


<style>
    header {
        background: linear-gradient(90deg, rgb(0, 195, 255), blue, rgb(0, 2, 102));
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 20px 40px 10px 50px;
        border: none;
        border-radius: none;
    }
    .downheader {
        background: linear-gradient(90deg,  rgb(12, 15, 160), rgb(0, 80, 133), rgb(0, 80, 133), rgb(1, 100, 146), rgb(0, 80, 133), rgb(0, 80, 133), rgb(12, 15, 160));
        height: 2px;
        width: 100%;
        display: flex;
        justify-content: center;
    }
    .downheader1 {
        background: linear-gradient(90deg, rgb(0, 1, 61), rgb(0, 75, 145), rgb(0, 100, 146), rgb(2, 132, 192), rgb(0, 100, 146), rgb(0, 75, 145), rgb(0, 1, 61));
        width: 100%;
        height: 157px;
        display: flex;
        justify-content: center;
    }
    li {
        display: inline-block;
        list-style-type: none;
        padding-right: 40px;

    }
    .home{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 0;
        border: none;
        border-radius: 8px;
        width: 70px;
        height: 35px;
        margin-left: 900px;
    }
    .aboutus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 0;
        border: none;
        border-radius: 8px;
        width: 90px;
        height: 35px;
    }
    .contactus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 0;
        border: none;
        border-radius: 8px;
        width: 103px;
        height: 35px;
    }
    .email,.discordinvite{
        background: rgb(255, 255, 255);
        background-size: 300% 300%;
        color: rgb(0, 0, 0);
        font-size: 33px;
        padding: 0;
        border: none;
        border-radius: 48px;
        width: 230px;
        height: 60px;
    }
    .discordinvite {
        background-color: (rgb(255, 0, 0));
    }
    .lowersection {
        display: flex;
        justify-content: center;
        height: 70px;
        width: 100%;
        background: linear-gradient(90deg, rgb(0, 1, 61), rgb(0, 75, 145), rgb(0, 100, 146), rgb(2, 132, 192), rgb(0, 100, 146), rgb(0, 75, 145), rgb(0, 1, 61));
        gap: 50px;
    }
    .formsection {
        display: flex;
        justify-content: center;
        height: 1000px;
        width: 100%;
        background: linear-gradient(90deg, rgb(0, 1, 61), rgb(0, 75, 145), rgb(0, 100, 146), rgb(2, 132, 192), rgb(0, 100, 146), rgb(0, 75, 145), rgb(0, 1, 61));
    }
    .blue-box {
        width: 600px; /* Set width */
        height: 400px; /* Set height */
        background-color: #0047AB; /* Blue color */
        position: static;
        top: 20px;
        border-radius: 48px;
    }
    .name {
        border-radius: 12px;
        width: 500px;
        height: 75px;     
        

    }
    .email {
        border-radius: 24px;
        
    }
    .message {
        border-radius: 24px;
        
    }
    .submit {
        border-radius: 24px;
        
    }
</style>

@code {

    //Navigation between pages
    private void playGameSecurityIDM()
    {
        NavigationManager.NavigateTo("SecurityIDM");
    }
    private void homeFf()
    {
        NavigationManager.NavigateTo("/");
    }
    private void aboutusFf()
    {
        NavigationManager.NavigateTo("/about-us");
    }
    private void contactusFf()
    {
        NavigationManager.NavigateTo("/contact-us");
    }
    private void thanks()
    {
        NavigationManager.NavigateTo("/thanks");
    }
<!--email automatization-->

    private void OpenMailClient()
    {
        var url = "https://mail.google.com/mail/u/0/?tab=rm&ogbl#inbox?compose=DmwnWtDnGmKzPzPLcPKblqLXJQQTXQmgZxqpSjTDdFBCQCxBKscKRqbxMddkdWrtzCwNBCHBrCml";
        if (JSRuntime != null)
        {
            JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }


<!--discord invite autmatization-->
    private void DiscordInvite()
    {
        var url = "https://discord.gg/MZp9j6NKrR";
        if (JSRuntime != null)
        {
            JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }
}
