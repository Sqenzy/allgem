@page "/contact-us"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us</title>
</head>
</html>



<header><strong>ALLGEM</strong>
    <li><button class="home" type="button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type="button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type="button" @onclick="contactusFf">Contact Us</button></li>
</header>

<section class="downheader"></section>

<section class="downheader1"></section>

<section class="lowersection">
    <button class="discordinvite" @onclick="DiscordInvite">
        <img src="discord-icon.png" class="discordicon"></button>
    <button class="email" @onclick="OpenMailClient">
        <img src="gmail-icon.png" class="gmailicon">
    </button>
</section>
<section class="formsection">
    <div class="blue-box"></div>
        <form class="from" action="https://formsubmit.co/36e6b93cb26f8ec08611000a741650f4" method="POST">
            <input class="name" type="text" name="name" required placeholder="Name" @bind-value="name" TValue="string">
            <input class="emaill" type="email" name="email" required placeholder="Email"@bind-value="email" TValue="string">
            <input type="text" class="message" name="message" required placeholder="Message"@bind-value="message" TValue="string">
            <input type="hidden" name="_captcha" value="false">
            <!--<input type="hidden" name="_cc" value="janlukavsky65@gmail.com"> >-->
            <input type="hidden" name="_next" value="http://localhost:5224/">
            <button class="submit" type="submit" @onclick="thanks">
  <div class="svg-wrapper-1">
    <div class="svg-wrapper">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="24"
        height="24"
      >
        <path fill="none" d="M0 0h24v24H0z"></path>
        <path
          fill="currentColor"
          d="M1.946 9.315c-.522-.174-.527-.455.01-.634l19.087-6.362c.529-.176.832.12.684.638l-5.454 19.086c-.15.529-.455.547-.679.045L12 14l6-8-8 6-8.054-2.685z"
        ></path>
      </svg>
    </div>
  </div>
  <span>Send</span></button>
        </form>
</section>


<style>
    .discordicon {
        width: 60px;
        height: 60px;
        margin-top: 0px;
    }
    .gmailicon {
        width: 40px;
        height: 30px;
        margin-top: -5px;
    }
.submit {
  font-family: inherit;
  font-size: 20px;
  background: rgb(10, 13, 20);
  color: white;
  padding: 0.7em 1em;
  padding-left: 0.9em;
  display: flex;
  align-items: center;
  border: none;
  border-radius: 16px;
  overflow: hidden;
  transition: all 0.2s;
  cursor: pointer;
}

.submit span {
  display: block;
  margin-left: 0.3em;
  transition: all 0.3s ease-in-out;
}

.submit svg {
  display: block;
  transform-origin: center center;
  transition: transform 0.3s ease-in-out;
}

.submit:hover .svg-wrapper {
  animation: fly-1 0.6s ease-in-out infinite alternate;
}

.submit:hover svg {
  transform: translateX(1.2em) rotate(45deg) scale(1.1);
}

.submit:hover span {
  transform: translateX(5em);
}

    header {
        background: rgb(10, 13, 20);
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 20px 40px 10px 50px;
        border: none;
        border-radius: none;
    }
    .downheader {
        background: rgb(31, 33, 48);
        height: 2px;
        width: 100%;
        display: flex;
        justify-content: center;
    }
    .downheader1 {
        background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
        width: 100%;
        height: 157px;
        display: flex;
        justify-content: center;
    }
    li {
        display: inline-block;
        list-style-type: none;
        padding-right: 40px;

    }
    .home{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 0;
        border: none;
        border-radius: 8px;
        width: 70px;
        height: 35px;
        margin-left: 900px;
    }
    .aboutus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 0;
        border: none;
        border-radius: 8px;
        width: 90px;
        height: 35px;
    }
    .contactus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 0;
        border: none;
        border-radius: 8px;
        width: 103px;
        height: 35px;
    }
    .email,.discordinvite{
        background-size: 300% 300%;
        color: rgb(255, 255, 255);
        font-size: 33px;
        padding: 0;
        border: none;
        border-radius: 48px;
        width: 230px;
        height: 60px;
    }
    .discordinvite {
        background: rgba(88, 101, 242, 1);
        outline: rgb(61, 75, 177);
        outline-style: solid;
        outline-width: 2px;
    }
    .discordinvite:hover {
        background: rgba(88, 101, 242, 1);
        width: 240px;
    }
    .email:hover {
        background: rgb(228, 228, 228);
        width: 240px;
    }
    .lowersection {
        display: flex;
        justify-content: center;
        height: 70px;
        width: 100%;
        background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
        gap: 50px;
    }
    .formsection {
        display: flex;
        justify-content: center;
        height: 534px;
        width: 100%;
        background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
    } 
    .blue-box {
        width: 600px; /* Set width */
        height: 430px; /* Set height */
        background-color: rgb(55, 56, 82);
        position: static;
        top: 20px;
        border-radius: 48px;
    }
    .from {
        margin-top: 70px;
    }
    .name {
        border-radius: 12px;
        width: 470px;
        height: 50px;     
        position: absolute;
        left: 50%;
        transform: translate(-50%, -50%);
    }
    .emaill {
        border-radius: 12px;
        position: absolute;
        left: 50%;
        transform: translate(-50%, -50%);
        margin-top: 70px;
        width: 470px;
        height: 50px; 
    }
    .message {
        border-radius: 12px;
        position: absolute;
        left: 50%;
        transform: translate(-50%, -50%);
        margin-top: 200px;
        width: 470px;
        height: 130px; 
    }
    .submit {
        border-radius: 12px;
        position: absolute;
        left: 50%;
        transform: translate(-50%, -50%);
        margin-top: 310px;
        width: 115px;
        height: 60px; 
    }
</style>
@code {
    private string name = string.Empty;
    private string email = string.Empty;
    private string message = string.Empty;
    //Navigation between pages
    private void playGameSecurityIDM()
    {
        NavigationManager.NavigateTo("SecurityIDM");
    }
    private void homeFf()
    {
        NavigationManager.NavigateTo("/");
    }
    private void aboutusFf()
    {
        NavigationManager.NavigateTo("/about-us");
    }
    private void contactusFf()
    {
        NavigationManager.NavigateTo("/contact-us");
    }
    private void thanks()
    {
        if (name=="" || email=="" || message=="")
        {
            JSRuntime.InvokeVoidAsync("alert", "Please fill all the fields.");
        }
        else
        {
            NavigationManager.NavigateTo("/thanks");
        }
    }
<!--email automatization-->

    private void OpenMailClient()
    {
        var url = "https://mail.google.com/mail/u/0/?tab=rm&ogbl#inbox?compose=DmwnWtDnGmKzPzPLcPKblqLXJQQTXQmgZxqpSjTDdFBCQCxBKscKRqbxMddkdWrtzCwNBCHBrCml";
        if (JSRuntime != null)
        {
            JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }


<!--discord invite autmatization-->
    private void DiscordInvite()
    {
        var url = "https://discord.gg/MZp9j6NKrR";
        if (JSRuntime != null)
        {
            JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }
}
