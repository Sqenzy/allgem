@page "/parkour/play"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allgem</title>
</head>
</html>


<header><strong>ALLGEM</strong>
    <li><button class="home" type=".button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type=".button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type=".button" @onclick="contactusFf">Contact Us</button></li>
</header>

<section class="downheader"></section>

<section class="lowersection">
    <div class="cards">
        <button class="qpbutton"><img src="/quickplay.png" class="qpimage"></button>
        <button class="csbutton">Create Cusstom Server</button>
    </div>
</section>


<style>
    header {
        background: rgb(10, 13, 20);
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 20px 40px 10px 50px;
        border: none;
        border-radius: none;
        
    }
    .downheader {
        background: rgb(31, 33, 48);
        height: 2px;
        width: 100%;
        display: flex;
        justify-content: center;
    }
    li{
        display: inline-block;
        list-style-type: none;
        padding-right: 40px;

    }
    .home{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 70px;
        height: 35px;
        margin-left: 900px;
    }
    .aboutus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 90px;
        height: 35px;
    }
    .contactus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 103px;
        height: 35px;
    }
    .lowersection {
        display: flex;
        justify-content: center;
        height: 95vh;
        width: 100%;
        background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
    }
.cards {
  display: flex;
  flex-direction: row;
  gap: 15px;
  margin-top: 213px;
}
.qpbutton,.csbutton{
    height: 50px;
    width: 50px;
}
</style>

@code {

    //Navigation between pages
    private void homeFf()
    {
        NavigationManager.NavigateTo("/");
    }
    private void aboutusFf()
    {
        NavigationManager.NavigateTo("/about-us");
    }
    private void contactusFf()
    {
        NavigationManager.NavigateTo("/contact-us");
    }
    private void game2Ff()
    {
        //Thread.Sleep(1500);
        NavigationManager.NavigateTo("/");
        var url = "https://sqenzy.github.io/parkourgamet/";
        if (JSRuntime != null)
        {
            JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }
}
