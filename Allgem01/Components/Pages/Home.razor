</div>

<header>
  @if (repository.IsLoggedIn)
    {
      @if (repository.hasPremium)
      {
        <img @onclick="homeFf" class="logopremium" src="/allgempremium.png" alt="ALLGEM PREMIUM">
        <img class="lpu">
      }
      else
      {
        <img @onclick="homeFf" class="logo" src="/allgemtext.png" alt="ALLGEM">   
      }
    }
    else
    {
      <img @onclick="homeFf" class="logo" src="/allgemtext.png" alt="ALLGEM">
    }
    <button class="mobileprofile" @onclick="MobileProfile" type="button">
      <img class="profileimg" src="/profile.png" alt="profile">
      </button>
    <nav>
    <li><button class="home" type="button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type="button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type="button" @onclick="contactusFf">Contact Us</button></li>
@if (repository.IsLoggedIn)
    {
      <button class="profile"  @onclick="accountFf" type="button">
          <img class="profileimg" src="/profile.png" alt="profile">
      </button>
      @if (profile == true)
      {
        <div class="profilemenu">
          <button class="logout" @onclick="Logout">Log Out</button>
        </div>
      }
      else{

      }
      @if (repository.hasPremium)
      {
      }
      else
      {
          <li><button class="premium" type="button" @onclick="premiumFf">Premium</button></li>
      }
    }
    else
    {
        <button class="login" @onclick="loginFf">
          <p class="lgtxt">Log In</p><p class="txt"> ›</p>
          </button>
    }
    </nav>
</header>

<section class="downheader"></section>

<section class="gamessection">
    <div class="cards">
        <button class="card" id="card1" @onclick="Graph">
            <p class="tip">Test Game</p>
            <p class="second-text"></p>
        </button>
        <button class="card" id="card2" @onclick="playGameSecurityIDM">
            <p class="tip">Multiplayer</p>
            <p class="second-text"></p>
        </button>
        <button class="card" id="card3" @onclick="playGameShooting">
            <p class="tip">Shooting</p>
            <p class="second-text"></p>
        </button>
    </div>
</section>

<section class="secondgamessection">
    <div class="cards">
        <button class="card" id="card4">
            <p class="tip">Upcoming Game</p>
            <p class="second-text"></p>
        </button>
        <button class="card" id="card5">
            <p class="tip">Upcoming Game</p>
            <p class="second-text"></p>
        </button>
        <button class="card" id="card6">
            <p class="tip">Upcoming Game</p>
            <p class="second-text"></p>
        </button>
    </div>
</section>

<section class="lowersection">Upcoming Events</section>
<footer>footer
</footer>
<style>
    header {
        background: rgb(10, 13, 20);
        min-width: 98vw;
        min-height: 9vh;
        display: flex;
        color: white;
        font-size: 16px;
        padding: 20px 40px 10px 50px;
        border: none;
        border-radius: none;
        position: sticky;
        top: 0px;
        flex-direction: column;
        z-index: 1000;
        opacity: 0.98;
        position: relative;
    }
    .downheader {
        background: rgb(31, 33, 48);
        height: 2px;
        width: 100%;
        display: flex;
        justify-content: center;
    }
    footer{
        background: rgb(10, 13, 20);
        color:  white;
        padding: 10px 20px;
        height: 100px;
    }
    li{
        display: inline-block;
        list-style-type: none;
        padding-right: 40px;

    }
    nav{
        margin-left: clamp(20px, 62vw, 80vw);
        flex-direction: column;
        margin-top: -40px;
        gap: 10px;
    }
    .home{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 70px;
        height: 35px;
        transition: all 0.1s ease-out;
        font-weight: bold;
        display: flex;
    }
    .home:hover{
        transform: translateY(-4px);
    }
    .aboutus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 90px;
        height: 35px;
        transition: all 0.1s ease-out;
        font-weight: bold;
    }
    .aboutus:hover{
        transform: translateY(-4px);
    }
    .contactus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 103px;
        height: 35px;
        transition: all 0.1s ease-out;
        font-weight: bold;
    }
    .contactus:hover{
        transform: translateY(-4px);
    }
    .mobileprofile{
      display: none;
      background: none;
      border: none;
      justify-content: center;
      align-items: center;
    }
    .logo{ 
     width: 130px; 
     height: 25px;
     margin-top: 11px; 
     background-size: contain; 
     background-repeat: no-repeat;
     background-position: center;
    }
    .logopremium{
     width: 142px; 
     height: 45px; 
     background-size: contain; 
     background-repeat: no-repeat;
     background-position: center;
    }
    .lpu{
      margin-top: 5px;
      margin-left: -4px;
      background: rgb(13, 134, 255);
      height: 2px;
      width: 150px;
    }
    .profile{
      border: none;
      background: none;
      height: 38px;
      width: 38px;
      transition: all 0.2s ease-out;
      margin-left: 50px;
    }
    .profileimg{
      width: 38px;
      height: 38px;
      transition: all 0.2s ease-out;
    }
    .profile:hover .profileimg{
      transform: scale(1.2, 1.2);
    }
.premium {
  width: fit-content;
  height: 40px;
  width: 105px;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-left: 514px;
  margin-top: -42px;
  border: none;
  font-weight: bold;
  border-radius: 20px;
  cursor: pointer;
  text-shadow: 2px 2px 3px rgb(136 0 136 / 50%);
  background: linear-gradient(
      15deg,
      #000088,
      #0022aa,
      #0044cc,
      #0066de,
      #0088f0,
      #0066de,
      #0044cc,
      #0022aa,
      #000088
    )
    no-repeat;
  background-size: 300%;
  background-position: left center;
  transition: background 0.3s ease;
  color: #fff;
}

.premium:hover {
  background-size: 320%;
  background-position: right center;
}
    .gamessection,.secondgamessection {
    display: flex; /* Align buttons in a row */
    flex-wrap: wrap; /* Wrap if screen is too small */
    flex-direction: row;
    justify-content: center; /* Center align */
    gap: 30px; /* Add space between buttons */
    background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
    }
    .gamessection {
    min-height: 100px;
    padding-top: 100px;
    }
    .secondgamessection {
    padding-top: 150px;
    min-height: 800px;
}  
body {
    margin: 0 !important;
    padding: 0 !important;
}
.cards {
  display: flex;
  flex-direction: row;
  gap: 40px;
  
}

.cards .card {
  flex: 3 3 calc(100% - 20px);
  min-width: 25vw;
  height: 260px;
  margin: 10px;
  color: white;
  cursor: pointer;
  background-color: rgb(55, 56, 82);
  transition: 250ms;
  border-radius: 20px;
}

.cards .card p.tip {
  font-size: 1em;
  font-weight: 700;
}

.cards .card p.second-text {
  font-size: .7em;
}

.cards .card:hover {
  transform: scale(1.1, 1.1);
}
.login {
  background: rgb(28, 75, 185);
  border: 0;
  margin-left: 420px;
  margin-top: -42px;
  border-radius: 18px;
  transition: 0.01s outline;
  color: white;
  height: 40px;
  width: 100px;
  display: flex;
  font-weight: bold;
}
.login:hover{
  outline: 2px rgb(202, 203, 206) solid;
}
.txt{
  margin-left: 13px;
  margin-top: 7px;
  transition: 0.25s all;
}
.login:hover .txt{
  margin-left: 20px;
}
.lgtxt {
  margin-left: 13px;
  margin-top: 7px;
}



