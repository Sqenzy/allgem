    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Read the cookie value
            CookieValue = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_auth");
            CookieValue1 = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_premium");

            // Update the authentication state based on the cookie value
            if (CookieValue == "isli")
            {
                repository.SetLoggedIn(true);
            }
            else
            {
                repository.SetLoggedIn(false);
            }

            if (CookieValue1 == "hsp")
            {
                repository.SetHasPremium(true);
            }
            else
            {
                repository.SetHasPremium(false);
            }

            StateHasChanged();
        }
    }
    private async Task Logout()
