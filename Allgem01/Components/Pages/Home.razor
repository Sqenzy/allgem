//This is margin backup
@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allgem</title>
</head>
</html>

<!--test-->


<header><strong>ALLGEM</strong>
    <li><button class="home" type="button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type="button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type="button" @onclick="contactusFf">Contact Us</button></li>
    <li><button class="account" type="button" @onclick="accountFf">Account</button></li>
</header>

<section class="downheader"></section>

<section class="gamessection">
<div class="cards">
    <div class="cards">
    <button class="card game1" @onclick="playGameParkour">
        <p class="tip">Test Game</p>
        <p class="second-text"></p>
    </button>
    <button class="card game2" @onclick="playGameSecurityIDM">
        <p class="tip">Multiplayer</p>
        <p class="second-text"></p>
    </button>
    <button class="card game3">
        <p class="tip">Upcoming Game</p>
        <p class="second-text"></p>
    </button>
</div>
</div>
</section>

<section class="secondgamessection">
    <div class="cards">
    <button class="card game1">
        <p class="tip">Upcoming Game</p>
        <p class="second-text">.......</p>
    </button>
    <button class="card game2">
        <p class="tip">Upcoming Game</p>
        <p class="second-text">.......</p>
    </button>
    <button class="card game3">
        <p class="tip">Upcoming Game</p>
        <p class="second-text">.......</p>
    </button>
</div>
</section>

<section class="lowersection">Upcoming Events</section>
<footer>footer
</footer>

<style>
    
    header {
        background: rgb(10, 13, 20);
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 20px 40px 10px 50px;
        border: none;
        border-radius: none;
        position: sticky;
        top: 0px;
        opacity: 0.98;
        z-index: 1000;
    }
    .downheader {
        background: rgb(31, 33, 48);
        height: 2px;
        width: 100%;
        display: flex;
        justify-content: center;
    }
    footer{
        background: rgb(10, 13, 20);
        color:  white;
        padding: 10px 20px;
        height: 100px;
    }
    li{
        display: inline-block;
        list-style-type: none;
        padding-right: 40px;

    }
    .home{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 0;
        border: none;
        border-radius: 8px;
        width: 70px;
        height: 35px;
        margin-left: 900px;
    }
    .aboutus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 90px;
        height: 35px;
    }
    .contactus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 103px;
        height: 35px;
    }
    .logo{ 
     width: 150px; 
     height: 150px;
     background-image: url("/images/imaginasie.png"); 
     background-size: contain; 
     background-repeat: no-repeat;
     background-position: center;
    }
    .gamessection,.secondgamessection {
    display: flex; /* Align buttons in a row */
    flex-wrap: wrap; /* Wrap if screen is too small */
    justify-content: center; /* Center align */
    gap: 30px; /* Add space between buttons */
    background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
    }
    .gamessection {
    min-height: 100px;
    padding-top: 200px;
    }
    .secondgamessection {
    padding-top: 200px;
    min-height: 800px;
}  
body {
    margin: 0 !important;
    padding: 0 !important;
}
.cards {
  display: flex;
  flex-direction: row;
  gap: 40px;
  
}

.cards .game1 {
  background-color: rgb(55, 56, 82);
}

.cards .game2 {
  background-color: rgb(55, 56, 82);
}

.cards .game3 {
  background-color: rgb(55, 56, 82);
}

.cards .card {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: row;
  text-align: center;
  height: 240px;
  width: 450px;
  border-radius: 20px;
  color: white;
  cursor: pointer;
  transition: 400ms;
}

.cards .card p.tip {
  font-size: 1em;
  font-weight: 700;
}

.cards .card p.second-text {
  font-size: .7em;
}

.cards .card:hover {
  transform: scale(1.1, 1.1);
}
</style>

@code {
