@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<!--test-->

<title>Allgem</title>

<header><strong>ALLGEM</strong>
    <li><button class="home" type="button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type="button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type="button" @onclick="contactusFf">Contact Us</button></li>
</header>
<section>

</section>

<section class="lowersection">lower-section</section>
<footer>footer
    <button @onclick="playGameSecurityIDM">PLAY</button>
</footer>

<style>
     body {
        background: rgb(88, 88, 88);
        color:  rgb(255, 255, 255);
        font-family: Arial, Helvetica, sans-serif;
        padding: 0px;
        margin: 0px;
    }
    
    header {
        background: linear-gradient(90deg, rgb(0, 174, 255), blue, rgb(0, 2, 102));
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 20px 40px 10px 50px;
        border: none;
        border-radius: 8px;

        
        
        
    }
    section {
        background: white;
        color: gray;
        height: 860px;
    }
    section div {
        padding: 0px;
        margin: 0px;
        background: lightgray;
        display: inline-block;
        width: 100px;
    }
    .lowersection {
        background: blue;
    }
    footer{
        background: black;
        color:  white;
        padding: 10px 20px;
        height: 100px;
    }
    li{
        display: inline-block;
        list-style-type: none;
        padding-right: 40px;

    }
    .home{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 70px;
        height: 35px;
        margin-left: 900px;
    }
    .aboutus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 90px;
        height: 35px;
    }
    .contactus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 103px;
        height: 35px;
    }
    .logo{ 
     width: 150px; 
     height: 150px;
     background-image: url("/images/imaginasie.png"); 
     background-size: contain; 
     background-repeat: no-repeat;
     background-position: center;
    }


</style>

@code {
    private void playGameSecurityIDM()
    {
        NavigationManager.NavigateTo("SecurityIDM");
    }
    private void homeFf()
    {
        NavigationManager.NavigateTo("/");
    }
    private void aboutusFf()
    {
        NavigationManager.NavigateTo("/about-us");
    }
    private void contactusFf()
    {
        NavigationManager.NavigateTo("/contact-us");
    }
}