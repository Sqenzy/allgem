@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allgem</title>
</head>
</html>

<!--test-->


<header><strong>ALLGEM</strong>
    <li><button class="home" type="button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type="button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type="button" @onclick="contactusFf">Contact Us</button></li>
</header>

<section class="gamessection">
    <button class="parkour" type="button" @onclick="playGameParkour">Parkour</button>
    <button class="security" type="button" @onclick="playGameSecurityIDM">Security IDM</button>
    <button class="u1" type="button">Upcoming Event</button>
</section>

<section class="secondgamessection">
    <button class="u2" type="button">Upcoming Event</button>
    <button class="u3" type="button">Upcoming Event</button>
    <button class="u4" type="button">Upcoming Event</button>
</section>

<section class="lowersection">Upcoming Events</section>
<footer>footer
</footer>

<style>
    
    header {
        background: linear-gradient(90deg, rgb(0, 174, 255), blue, rgb(0, 2, 102));
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 20px 40px 10px 50px;
        border: none;
        border-radius: none;
    }
    .lowersection {
        background: linear-gradient(90deg, rgb(0, 174, 255), blue, rgb(0, 2, 102));
    }
    footer{
        background: linear-gradient(90deg, rgb(0, 174, 255), blue, rgb(0, 2, 102));
        color:  white;
        padding: 10px 20px;
        height: 100px;
    }
    li{
        display: inline-block;
        list-style-type: none;
        padding-right: 40px;

    }
    .home{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 70px;
        height: 35px;
        margin-left: 900px;
    }
    .aboutus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 90px;
        height: 35px;
    }
    .contactus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 103px;
        height: 35px;
    }
    .logo{ 
     width: 150px; 
     height: 150px;
     background-image: url("/images/imaginasie.png"); 
     background-size: contain; 
     background-repeat: no-repeat;
     background-position: center;
    }
    .gamessection {
    display: flex; /* Align buttons in a row */
    flex-wrap: wrap; /* Wrap if screen is too small */
    justify-content: center; /* Center align */
    gap: 30px; /* Add space between buttons */
    background: linear-gradient(90deg, rgb(0, 174, 255), blue, rgb(0, 2, 102));
    padding-top: 100px;
    min-height: 100px;
}
    .secondgamessection {
    display: flex; /* Align buttons in a row */
    flex-wrap: wrap; /* Wrap if screen is too small */
    justify-content: center; /* Center align */
    gap: 30px; /* Add space between buttons */
    background: linear-gradient(90deg, rgb(0, 174, 255), blue, rgb(0, 2, 102));
    padding-top: 200px;
    min-height: 800px;
}  


.gamessection button {
    background: white;
    color: black;
    border: none;
    padding: 60px 80px;
    border-radius: 40px;
    font-size: 32px;
    cursor: pointer;
    height: 20px;
}
.secondgamessection button {
    background: white;
    color: black;
    border: none;
    padding: 60px 57px;
    border-radius: 40px;
    font-size: 32px;
    cursor: pointer;
    height: 20px;
}
</style>

@code {
    private void playGameSecurityIDM()
    {
        NavigationManager.NavigateTo("/game2");
    }
    private void playGameParkour()
    {
        NavigationManager.NavigateTo("/game1");
    }
    private void homeFf()
    {
        NavigationManager.NavigateTo("/");
    }
    private void aboutusFf()
    {
        NavigationManager.NavigateTo("/about-us");
    }
    private void contactusFf()
    {
        NavigationManager.NavigateTo("/contact-us/email");
    }
}
