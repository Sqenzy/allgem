@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<!--test-->

<title>Allgem</title>

<header>welcome to ALLGEM
    <button class="home" type="button" @onclick="homeFf">Home</button>
    <button class="aboutus" type="button" @onclick="homeFf">About Us</button>
    <button class="contactus" type="button" @onclick="homeFf">Contact Us</button>
    
</header>
<section>

</section>

<section class="lowersection">lower-section</section>
<footer>footer
    <button @onclick="playGameSecurityIDM">PLAY</button>
</footer>

<style>
     body {
        background: gray;
        color:  white;
        font-family: Arial, Helvetica, sans-serif;
        padding: 0px;
        margin: 0px;
    }
    
    header {
        background: black;
        color:  white;
        padding: 20px 40px 10px 50px;
        
    }
    section {
        background: white;
        color: gray;
        height: 860px;
    }
    section div {
        padding: 0px;
        margin: 0px;
        background: lightgray;
        display: inline-block;
        width: 100px;
    }
    .lowersection {
        background: blue;
    }
    footer{
        background: black;
        color:  white;
        padding: 10px 20px;
        height: 100px;
    }
</style>

@code {
    private void playGameSecurityIDM()
    {
        NavigationManager.NavigateTo("SecurityIDM");
    }
    private void homeFf()
    {
        NavigationManager.NavigateTo("/about-us");
    }
}
