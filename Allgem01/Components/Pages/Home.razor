@page "/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allgem</title>
</head>
</html>

<!--test-->


<header><strong>ALLGEM</strong>
    <li><button class="home" type="button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type="button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type="button" @onclick="contactusFf">Contact Us</button></li>
</header>

<section class="downheader"></section>

<section class="gamessection">
    <button class="parkour" type="button" @onclick="playGameParkour">Parkour</button>
    <button class="security" type="button" @onclick="playGameSecurityIDM">Security IDM</button>
    <button class="u1" type="button">Upcoming Event</button>
</section>

<section class="secondgamessection">
    <button class="u2" type="button">Upcoming Event</button>
    <button class="u3" type="button">Upcoming Event</button>
    <button class="u4" type="button">Upcoming Event</button>
</section>

<section class="lowersection">Upcoming Events</section>
<footer>footer
</footer>

<style>
    
    header {
        background: linear-gradient(90deg, rgb(0, 195, 255), blue, rgb(0, 2, 102));
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: 20px 40px 10px 50px;
        border: none;
        width: 100%;
        border-radius: none;
        position: sticky;
        top: 0px;
        z-index: 1000;
        opacity: 0.98;
        display: flex;
        flex-wrap: nowrap;
    }
    .downheader {
        background: linear-gradient(90deg,  rgb(12, 15, 160), rgb(0, 80, 133), rgb(0, 80, 133), rgb(1, 100, 146), rgb(0, 80, 133), rgb(0, 80, 133), rgb(12, 15, 160));
        height: 2px;
        width: 100%;
        display: flex;
        justify-content: center;
    }
    footer{
        background: linear-gradient(90deg, rgb(2, 132, 192), blue, rgb(0, 2, 102));
        color:  white;
        padding: 10px 20px;
        height: 100px;
    }
    li{
        display: inline-block;
        list-style-type: none;
        padding-right: 40px;

    }
    .home{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 70px;
        height: 35px;
        margin-left: 900px;
    }
    .aboutus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 90px;
        height: 35px;
    }
    .contactus{
        background: none;
        background-size: 300% 300%;
        color: white;
        font-size: 16px;
        padding: none;
        border: none;
        border-radius: 8px;
        width: 103px;
        height: 35px;
    }
    .logo{ 
     width: 150px; 
     height: 150px;
     background-image: url("/images/imaginasie.png"); 
     background-size: contain; 
     background-repeat: no-repeat;
     background-position: center;
    }
    .gamessection,.secondgamessection {
    display: flex; /* Align buttons in a row */
    flex-wrap: wrap; /* Wrap if screen is too small */
    justify-content: center; /* Center align */
    gap: 30px; /* Add space between buttons */
    background: linear-gradient(90deg, rgb(0, 1, 61), rgb(0, 75, 145), rgb(0, 100, 146), rgb(2, 132, 192), rgb(0, 100, 146), rgb(0, 75, 145), rgb(0, 1, 61));
    }
    .gamessection {
    min-height: 100px;
    padding-top: 200px;
    }
    .secondgamessection {
    padding-top: 200px;
    min-height: 800px;
}  


.gamessection button {
    background: white;
    color: black;
    border: none;
    padding: 60px 60px;
    border-radius: 40px;
    font-size: 32px;
    cursor: pointer;
    height: 20px;
    priority: 1;
}
.secondgamessection button {
    background: white;
    color: black;
    border: none;
    padding: 60px 60px;
    border-radius: 40px;
    font-size: 32px;
    cursor: pointer;
    height: 20px;
}
.parkour {
    height: 40px;
    width: 360px;
}
.security {
    height: 40px;
    width: 360px;
}
.u1 {
    height: 40px;
    width: 360px;
}
.u2 {
    height: 40px;
    width: 360px;
}
.u3 {
    height: 40px;
    width: 360px;
}
.u4 {
    height: 40px;
    width: 360px;
}
</style>

@code {
    private void playGameSecurityIDM()
    {
        //NavigationManager.NavigateTo("/security-idm");
        var url = "https://sqenzy.github.io/multyplayergametest/";
        if (JSRuntime != null)
        {
            JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }
    private void playGameParkour()
    {
        //NavigationManager.NavigateTo("/parkour");
        var url = "https://sqenzy.github.io/gametest/";
        if (JSRuntime != null)
        {
            JSRuntime.InvokeVoidAsync("window.open", url, "_blank");
        }
    }
    private void homeFf()
    {
        NavigationManager.NavigateTo("/");
    }
    private void aboutusFf()
    {
        NavigationManager.NavigateTo("/about-us");
    }
    private void contactusFf()
    {
        NavigationManager.NavigateTo("/contact-us");
    }
}
