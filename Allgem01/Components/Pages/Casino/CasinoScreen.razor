@page "/casino/loading"
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<div class="loading-container" id="loadingContainer">
  <img src="/allgemtext.png" alt="ALLGEM" class="logo">
        <div class="loading-spinner"></div>
        <div class="loading-text">Casino</div>
</div>

<style>
  .loading-container {
    background: rgb(10, 13, 20);
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 30px;
            width: 100vw;
        height: 1000vh;
        z-index: -1;
        background-size: cover;
        background-position: center;
        }
        
        .logo {
            width: 200px;
            height: auto;
            margin-top: 200px;
        }
        
        .loading-text {
            font-size: 18px;
            font-weight: bold;
            color: white;
            margin-top: 200px;
            opacity: 0.8;
        }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Kk();
    }

    private void Kk()
    {
        Thread.Sleep(2000);
        NavigationManager.NavigateTo("/casino", forceLoad: true);  
    }
}