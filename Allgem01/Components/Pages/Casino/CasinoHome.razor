.cards {
  display: flex;
  flex-direction: row;
  gap: 40px;
  
}

.cards .card {
  position: relative;
  flex: 3 3 calc(100% - 20px);
  min-width: 11vw;
  max-width: 230px;
  height: 250px;
  margin: 10px;
  color: white;
  cursor: pointer;
  background-color: rgb(55, 56, 82);
  transition: 250ms;
  border-radius: 20px;
}

.cards .card p.tip {
  position: absolute;
  top: 10px;
  left: 0;
  width: 100%;
  text-align: center;
  background: none;
  margin: 0;
  font-size: 1.2em;
  font-weight: bold;
  color: white;
  z-index: 2;
  pointer-events: none;
}

.cards .card p.second-text {
  position: absolute;
  top: 10px;
  left: 0;
  width: 100%;
  text-align: center;
  background: none;
  margin: 0;
  font-size: 1.2em;
  font-weight: bold;
  color: white;
  z-index: 2;
  pointer-events: none;
}

.cards .card:hover {
  transform: scale(1.1, 1.1);
}
