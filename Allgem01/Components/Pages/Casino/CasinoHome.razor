    private string? CookieValue;
    private string? CookieValue1;
    private string? CookieValueRank;
    private string? CookieValueEmail;
    private string? CookieValueCas;
    private bool profile = false;
    private string rankimg = "/bronze.png";
    public int Money;


    private bool isAcknowledged = false;

    private void AcknowledgeDisclaimer()
    {
        isAcknowledged = true;
        CreateCookie("casino_disclaimer_acknowledged", "true", 999999);
        NavigationManager.NavigateTo("/casino");
    }

    private void Profile()
    {
       if (profile == false)
       {
           profile = true;
       }
       else
       {
           profile = false;
       }
    }

    private void devFf()
    {
        NavigationManager.NavigateTo("/developer-panel");
    }

    private void MobileProfile()
    {
      NavigationManager.NavigateTo("/account");
    }

    private void termFf()
    {
        NavigationManager.NavigateTo("/terms-and-conditions");
    }

    private void Mines()
    {
      NavigationManager.NavigateTo("/casino/mines");
    }

    private void playGameShooting()
    {
        //NavigationManager.NavigateTo("/shooting/play");
    }
    private void accountFf()
    {
        NavigationManager.NavigateTo("/account");
    }
    private async Task playGameSecurityIDM()
    {
      NavigationManager.NavigateTo("/casino/flip");
    }
    private void loginFf()
    {
      NavigationManager.NavigateTo("/login");
    }
    private void homeFf()
    {
        NavigationManager.NavigateTo("/");
    }
    private void aboutusFf()
    {
        NavigationManager.NavigateTo("/about-us");
    }
    private void contactusFf()
    {
        NavigationManager.NavigateTo("/contact-us");
    }
    private void premiumFf()
    {
        NavigationManager.NavigateTo("/premium");
    }
    private void playPlinko()
    {
        NavigationManager.NavigateTo("/casino/line");
    }
    private void TowerOf4()
    {
        NavigationManager.NavigateTo("/casino/towerof4");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Money = repository.CasinoMoney;
            // Read the cookie value
            CookieValue = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_auth");
            CookieValue1 = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_premium");
            CookieValueEmail = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_email");
            var moneyString = await JSRuntime.InvokeAsync<string>("getCookie", "acm");
            int.TryParse(moneyString, out Money);
            CookieValueCas = await JSRuntime.InvokeAsync<string>("getCookie", "casino_disclaimer_acknowledged");

            if (string.IsNullOrEmpty(CookieValueCas))
            {
                CookieValueCas = "false";
            }
            else if (CookieValueCas == "true")
            {
                isAcknowledged = true;
            }


            // Update the authentication state based on the cookie value
            if (CookieValue == "isli")
            {
                repository.SetLoggedIn(true);
            }
            else
            {
                repository.SetLoggedIn(false);
            }

            if (CookieValue1 == "hsp")
            {
                repository.SetHasPremium(true);
            }
            else
            {
                repository.SetHasPremium(false);
            }

            repository.CheckRank(CookieValueEmail);

            if (!string.IsNullOrEmpty(repository.rank))
            {
                // Update the rank cookie if it doesn't match the current rank
                CookieValueRank = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_rank");
                if (CookieValueRank != repository.rank)
                {
                    CreateCookie("allgem_rank", repository.rank, 2592000); // 30 days in seconds
                }
            }

            if (CookieValueRank == "Bronze")
            {
              rankimg = "/bronze.png";
            }
            else if (CookieValueRank == "Silver")
            {
              rankimg = "/silver.png";
            }
            else if (CookieValueRank == "Gold")
            {
              rankimg = "/gold.png";
            }
            else if (CookieValueRank == "Platinum")
            {
              rankimg = "/platinum.png";
            }
            else if (CookieValueRank == "Diamond")
            {
              rankimg = "/diamond.png";
            }
            else if (CookieValueRank == "Contributor")
            {
              rankimg = "/diamond.png";
            }
            else if (CookieValueRank == "Dev")
            {
              rankimg = "/diamond.png";
            }
            else if (CookieValueRank == "Nigger")
            {
              rankimg = "/diamond.png";
            }

            StateHasChanged();
            await JSRuntime.InvokeVoidAsync("topFunction");
        }
    }
    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_auth");
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_premium");
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_rank");

        repository.SetLoggedIn(false);
        NavigationManager.NavigateTo("/");
        }

    private async void CreateCookie(string name, string value, int days)
    {
        await JSRuntime.InvokeVoidAsync("methods.CreateCookie", name, value, days);
    }
}