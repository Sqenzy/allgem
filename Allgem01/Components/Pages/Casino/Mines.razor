    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Money = repository.CasinoMoney;

            // Read the cookie value
            CookieValue = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_auth");
            CookieValue1 = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_premium");
            CookieValueEmail = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_email");
            CookieValueRank = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_rank");
            var moneyString = await JSRuntime.InvokeAsync<string>("getCookie", "acm");
            int.TryParse(moneyString, out Money);


            // Update the authentication state based on the cookie value
            if (CookieValue == "isli")
            {
                repository.SetLoggedIn(true);
            }
            else
            {
                repository.SetLoggedIn(false);
            }

            if (CookieValue1 == "hsp")
            {
                repository.SetHasPremium(true);
            }
            else
            {
                repository.SetHasPremium(false);
            }
            StateHasChanged();
            if (repository.IsLoggedIn)
            {
                dik = true;
                _ = RankosAsync();
            }
            else
            {
                dik = false;
            }
        }
    }
    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_auth");
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_premium");
        repository.SetLoggedIn(false);
        NavigationManager.NavigateTo("/");
    }

private async Task RankosAsync()
{
    if (CookieValueRank == "Silver")
    {
        repository.rankCount = 10;
    }
    else if (CookieValueRank == "Gold")
    {
        repository.rankCount = 20;
    }
    else if (CookieValueRank == "Platinum")
    {
        repository.rankCount = 30;
    }
    else if (CookieValueRank == "Diamond")
    {
        repository.rankCount = 40;
    }
    else
    {
        repository.rankCount = 0;
    }
    while (dik)
    {
        await Task.Delay(10000);
        repository.rankCount++;

        if (repository.rankCount == 10)
        {
            repository.AddRankToUser(CookieValueEmail, "Silver");
        }
        else if (repository.rankCount == 20)
        {
            repository.AddRankToUser(CookieValueEmail, "Gold");
        }
        else if (repository.rankCount == 30)
        {
            repository.AddRankToUser(CookieValueEmail, "Platinum");
        }
        else if (repository.rankCount == 40)
        {
            repository.AddRankToUser(CookieValueEmail, "Diamond");
        }
    }
}
}

@code {
    private int betAmount = 0;
    private const int mineCount = 6;
    private bool gameStarted = false;
    private bool gameOver = false;
    int revealedDiamonds = 0;
    
    private class Tile
    {
        public bool Revealed { get; set; }
        public bool IsMine { get; set; }
        public bool IsDiamond { get; set; }
    }
    
    private Tile[,] grid = new Tile[5, 5];
    private Random random = new Random();

    protected override void OnInitialized()
    {
        InitializeGrid();
    }

    private void InitializeGrid()
    {
        for (int y = 0; y < 5; y++)
        {
            for (int x = 0; x < 5; x++)
            {
                grid[y, x] = new Tile();
            }
        }
    }

    private void StartGame()
    {
       Money -= betAmount;
       Money = Math.Max(Money, -1000);

        
        if (betAmount <= 0)
        {
            // Add validation for bet amount
            return;
        }

        gameStarted = true;
        gameOver = false;
        
        // Initialize grid
        for (int y = 0; y < 5; y++)
        {
            for (int x = 0; x < 5; x++)
            {
                grid[y, x] = new Tile { Revealed = false, IsMine = false, IsDiamond = false };
            }
        }

        // Place mines
        int minesPlaced = 0;
        while (minesPlaced < mineCount)
        {
            int x = random.Next(0, 5);
            int y = random.Next(0, 5);
            if (!grid[y, x].IsMine)
            {
                grid[y, x].IsMine = true;
                minesPlaced++;
            }
        }

        // Place diamonds (remaining tiles)
        int diamondCount = 25 - mineCount; // Total tiles - mines
        for (int y = 0; y < 5; y++)
        {
            for (int x = 0; x < 5; x++)
            {
                if (!grid[y, x].IsMine)
                {
                    grid[y, x].IsDiamond = true;
                }
            }
        }

        CreateCookie("acm", Money.ToString(), 2592000);
        
        StateHasChanged();
    }

    private void RevealTile(int x, int y)
    {
        // Check if game has started
        if (!gameStarted)
        {
            return;
        }

        // Check if game is over
        if (gameOver)
        {
            return;
        }

        // Check bounds
        if (x < 0 || x >= 5 || y < 0 || y >= 5)
        {
            return;
        }

        // Check if tile is already revealed
        if (grid[y, x].Revealed)
        {
            return;
        }

        // Reveal the tile
        grid[y, x].Revealed = true;

        if (grid[y, x].IsMine)
        {
            // Game over - reveal all mines
            gameOver = true;
            for (int row = 0; row < 5; row++)
            {
                for (int col = 0; col < 5; col++)
                {
                    if (grid[row, col].IsMine)
                    {
                        grid[row, col].Revealed = true;
                    }
                }
            }
        }
        else if (grid[y, x].IsDiamond)
        {
            // Check win condition
            CheckWinCondition();
        }
        
        StateHasChanged();
    }

    private void CheckWinCondition()
    {
        revealedDiamonds = 0;
        for (int y = 0; y < 5; y++)
        {
            for (int x = 0; x < 5; x++)
            {
                if (grid[y, x].Revealed && grid[y, x].IsDiamond)
                {
                    revealedDiamonds++;
                }
            }
        }

        // If all diamonds are revealed, player wins
        if (revealedDiamonds == 25 - mineCount)
        {
            gameOver = true;
            // Add win logic here
        }
    }

    private void ResetGame()
    {
        gameStarted = false;
        gameOver = false;
        InitializeGrid();
        StateHasChanged();
    }

    private void Checkout()
    {

        if (revealedDiamonds == 1)
        {
           Money += betAmount * 1;
        }
        else if (revealedDiamonds == 2)
        {
           Money += betAmount * 2;
        }
        else if (revealedDiamonds == 3)
        {
           Money += betAmount * 3;
        }
        else if (revealedDiamonds == 4)
        {
           Money += betAmount * 4;
        }
        else if (revealedDiamonds == 5)
        {
           Money += betAmount * 5;
        }

        repository.SetCasinoMoney(Money);

        CreateCookie("acm", Money.ToString(), 2592000);

        gameStarted = false;
        gameOver = false;

    }

    private async void CreateCookie(string name, string value, int days)
    {
        await JSRuntime.InvokeVoidAsync("methods.CreateCookie", name, value, days);
    }
}