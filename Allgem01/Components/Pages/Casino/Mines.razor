@page "/casino/mines"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@using Allgem01.Logic
@inject Repository repository

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allgem</title>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1918445686655465"
     crossorigin="anonymous"></script>
</head>
</html>


<header>
  @if (repository.IsLoggedIn)
    {
      
      @if (repository.hasPremium)
      {
        <img @onclick="homeFf" class="logopremium" src="/allgempremium.png" alt="ALLGEM PREMIUM">
        <img class="lpu">
      }
      else
      {
        <img @onclick="homeFf" class="logo" src="/allgemtext.png" alt="ALLGEM">   
      }
    }
    else
    {
      <img @onclick="homeFf" class="logo" src="/allgemtext.png" alt="ALLGEM">
    }
    <button class="mobileprofile" @onclick="MobileProfile" type="button">
      <img class="profileimg" src="/profile.png" alt="profile">
      </button>
    <nav>
    <li><button class="home" type="button" @onclick="homeFf">Home</button></li>
    <li><button class="aboutus" type="button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type="button" @onclick="contactusFf">Contact Us</button></li>
@if (repository.IsLoggedIn)
    {
      <button class="profile"  @onclick="accountFf" type="button">
          <img class="profileimg" src="/profile.png" alt="profile">
      </button>
      @if (profile == true)
      {
        <div class="profilemenu">
          <button class="logout" @onclick="Logout">Log Out</button>
        </div>
      }
      else{

      }
      @if (repository.hasPremium)
      {
      }
      else
      {
          
      }
    }
    else
    {
        <button class="login" @onclick="loginFf">
          <p class="lgtxt">LogIn</p>
          </button>
    }
    </nav>
</header>

<section class="downheader"></section>

<section class="balancesection">
  <li><div class="balance">Balance: @Money</div></li>
</section>

<section class="lowersection">
<div class="mines-game">
        <div class="game-controls">
            <label>
                <span>Amount:</span>
                <input type="number" @bind="betAmount" min="0.01" step="0.01" placeholder="0.00" />
                <span>$</span>
            </label>
            <label>
                <span>💣 Mines:</span>
                <span class="mines-count">6</span>
            </label>
            @if (!gameStarted)
            {
                <button @onclick="StartGame" class="play-button">
                    🎮 Play
                </button>
            }
            else if (!gameOver)
            {
                <button @onclick="Checkout" class="reset-button">
                    💰 Checkout
                </button>
            }
        </div>
        
        @if (gameOver)
        {
            <div class="game-status">
                <span>💥 Game Over!</span>
                <button @onclick="ResetGame" class="play-again-button">
                    ↻ Play Again
                </button>
            </div>
        }
        
    <div class="game-grid">
        @for (int y = 0; y < 5; y++)
        {
            <div class="grid-row">
                @for (int x = 0; x < 5; x++)
                {
                    int localX = x; // Capture loop variable
                    int localY = y; // Capture loop variable
                    <div class="grid-tile @(grid[y, x].Revealed ? "revealed" : "")" 
                         @onclick="() => RevealTile(localX, localY)" 
                         @onclick:stopPropagation="true">
                        @if (grid[y, x].Revealed)
                        {
                            @if (grid[y, x].IsMine)
                            {
                                <span class="mine">💣</span>
                            }
                            else if (grid[y, x].IsDiamond)
                            {
                                <span class="diamond">💎</span>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
</section>


<style>

  .balancesection {
    height: 60px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 0px;
    background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
  }

  .balance {
    font-size: 16px;
    color: white;
    font-weight: bold;
    align-items: center;
    display: flex;
    justify-content: center;
    height: 40px;
    width: 250px;
    background-color: rgb(39, 39, 39);
    outline: rgb(129, 129, 129) solid 1px;
    border-radius: 12px;
    margin: 15px auto 0 auto;
  }

    .mines-game {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 30px;
    background: linear-gradient(135deg, #0f1419 0%, #1a2332 100%);
    border-radius: 20px;
    color: white;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    margin: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    width: 35vw;
    height: 80vh;
}

.game-controls {
    display: flex;
    gap: 20px;
    margin-bottom: 30px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    padding: 20px;
    border-radius: 15px;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.game-controls label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    font-size: 16px;
    color: #e0e6ed;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

.game-controls input {
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    color: white;
    border-radius: 10px;
    font-size: 16px;
    font-weight: 600;
    width: 120px;
    text-align: center;
    transition: all 0.3s ease;
}

.game-controls input:focus {
    outline: none;
    border-color: #0084ff;
    box-shadow: 0 0 20px rgba(0, 174, 255, 0.3);
    background: rgba(255, 255, 255, 0.15);
}

.play-button, .reset-button {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    padding: 14px 28px;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    font-size: 16px;
    font-weight: 700;
    color: white;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
    box-shadow: 0 8px 16px rgba(16, 185, 129, 0.3);
    position: relative;
    overflow: hidden;
}

.play-button:hover, .reset-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(16, 185, 129, 0.4);
}

.play-button:active, .reset-button:active {
    transform: translateY(0);
}

.reset-button {
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    box-shadow: 0 8px 16px rgba(239, 68, 68, 0.3);
}

.reset-button:hover {
    box-shadow: 0 12px 24px rgba(239, 68, 68, 0.4);
}

.game-status {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 20px;
    background: rgba(239, 68, 68, 0.1);
    border: 2px solid rgba(239, 68, 68, 0.3);
    border-radius: 15px;
    font-size: 18px;
    font-weight: 700;
    color: #fecaca;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

.play-again-button {
    background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
    padding: 10px 20px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    color: white;
    transition: all 0.3s ease;
    box-shadow: 0 4px 8px rgba(59, 130, 246, 0.3);
}

.play-again-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 12px rgba(59, 130, 246, 0.4);
}

.game-grid {
    display: grid;
    grid-template-columns: repeat(5, 80px);
    grid-template-rows: repeat(5, 80px);
    gap: 8px;
    background: rgba(0, 0, 0, 0.3);
    padding: 20px;
    border-radius: 20px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 4px 8px rgba(0, 0, 0, 0.3);
}

.grid-row {
    display: contents;
}

.grid-tile {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #374151 0%, #1f2937 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
}

.grid-tile::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.grid-tile:hover::before {
    opacity: 1;
}

.grid-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 255, 255, 0.2);
}

.grid-tile:active {
    transform: translateY(0);
}

.grid-tile.revealed {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-color: rgba(255, 255, 255, 0.2);
    cursor: default;
    transform: none;
}

.grid-tile.revealed:hover {
    transform: none;
    box-shadow: none;
}

.grid-tile.revealed.mine {
    background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
    border-color: #fca5a5;
    animation: explode 0.3s ease-out;
}

.grid-tile.revealed.diamond {
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    border-color: #6ee7b7;
    animation: sparkle 0.5s ease-out;
}


.mine {
    font-size: 32px;
    animation: bounce 0.5s ease-in-out;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
}

.diamond {
    font-size: 32px;
    animation: shine 0.5s ease-in-out;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
}


/* Add some glow effects for mines and diamonds */
.grid-tile.revealed.mine .mine {
    text-shadow: 0 0 10px #ff4444, 0 0 20px #ff4444, 0 0 30px #ff4444;
}

.grid-tile.revealed.diamond .diamond {
    text-shadow: 0 0 10px #00ff88, 0 0 20px #00ff88, 0 0 30px #00ff88;
}

