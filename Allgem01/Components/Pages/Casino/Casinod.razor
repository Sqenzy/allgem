@page "/casinod"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Casino</title>
</head>
<body>
    <div class="disclaimer-modal">
            <div class="disclaimer-content">
                <h3>Important Disclaimer</h3>
                <p>This website offers games with virtual currency for entertainment purposes only. No real money is used or can be won. Gambling with real money can be highly addictive and may lead to serious financial and personal harm. We strongly advise against participating in real-money gambling. Play responsibly and for fun only.</p>
                <button class="acknowledge-button" @onclick="AcknowledgeDisclaimer">I Understand</button>
            </div>
        </div>
    <style>
        .lowersection {
            display: flex;
            justify-content: center;
            height: 100vh;
            width: 100%;
            background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
        }
        h1 {
            font-size: 50px;
            color: white;
            position: absolute;
            top: 30%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        h2 {
            font-size: 30px;
            color: white;
            position: absolute;
            top: 40%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        .disclaimer-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .disclaimer-content {
            background: rgb(18, 19, 32);
            padding: 20px;
            border-radius: 10px;
            max-width: 500px;
            width: 90%;
            text-align: center;
            color: white;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
        }
        .disclaimer-content h3 {
            font-size: 24px;
            margin-bottom: 15px;
        }
        .disclaimer-content p {
            font-size: 16px;
            margin-bottom: 20px;
        }
        .acknowledge-button {
            background: #1a73e8;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            transition: background 0.3s;
        }
        .acknowledge-button:hover {
            background: #1557b0;
        }
    </style>
</body>
</html>


@code {
    
    private void AcknowledgeDisclaimer()
    {
        CreateCookie("casino_disclaimer_acknowledged", "true", 999999);
        NavigationManager.NavigateTo("/casino");
    }

    private async void CreateCookie(string name, string value, int days)
    {
        await JSRuntime.InvokeVoidAsync("methods.CreateCookie", name, value, days);
    }
}