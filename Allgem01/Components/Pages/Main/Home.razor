    private readonly TimeSpan refreshDelay = TimeSpan.FromSeconds(1); // 1 second delay
    private bool isRefreshBlocked = false;
    private bool isSideBoxExpanded = false;

    private void ToggleSideBox()
    {
        isSideBoxExpanded = !isSideBoxExpanded;
        StateHasChanged();
    }

    private bool CanRefresh()
    {
        var now = DateTime.Now;
        if (now - lastRefreshTime < refreshDelay)
        {
            isRefreshBlocked = true;
            // Auto-hide the message after 1 second
            _ = Task.Run(async () =>
            {
                await Task.Delay(1000);
                isRefreshBlocked = false;
                await InvokeAsync(StateHasChanged);
            });
            return false;
        }
        isRefreshBlocked = false;
        lastRefreshTime = now;
        return true;
    }

