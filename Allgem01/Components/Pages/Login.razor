@page "/login"
@using Allgem01.Logic
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject Repository repository

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log In</title>
</head>
<body>
    
</body>
</html>

<section class="boxsection">
        <input id="email-input" placeholder="Enter your email" type="email" @bind="email">
        <input id="password-input" placeholder="Enter your password" type="password" @bind="password">
        <button @onclick="logIn">Log In</button>
</section>



<style>

    body {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        margin: 0;
        background: linear-gradient(to right,rgb(12, 18, 56),rgb(17, 18, 34),rgb(18, 19, 32),rgb(15, 15, 24),rgb(18, 19, 32),rgb(18, 19, 32),rgb(11, 18, 71));
    }
    .boxsection {
        height: 300px;
        width: 300px;
        flex-direction: column;
        align-items: center;
        background-color: white;
    }

    input {
        margin: 10px;
        padding: 5px;
    }

    button {
        margin: 10px;
        padding: 5px;
    }
</style>
@code {
    private string? email;
    private string? password;

    private void logIn()
    {
        if (string.IsNullOrEmpty(email))
        {
            // Handle the case where email is null or empty
            return;
        }

        if (string.IsNullOrEmpty(password))
        {
            // Handle the case where password is null or empty
            return;
        }

        repository.Login(email, password);
    }
}