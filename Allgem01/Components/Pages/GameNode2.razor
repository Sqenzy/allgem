        <div class="profilemenu">
          <button class="logout" @onclick="Logout">Log Out</button>
        </div>
      }
      else{

      }
      @if (repository.hasPremium)
      {
      }
      else
      {
          
      }
    }
    else
    {
        <button class="login" @onclick="loginFf">
          <p class="lgtxt">LogIn</p>
          </button>
    }
    </nav>
</header>

