    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Money = repository.CasinoMoney;

            // Read the cookie value
            CookieValue = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_auth");
            CookieValue1 = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_premium");
            CookieValueEmail = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_email");
            CookieValueRank = await JSRuntime.InvokeAsync<string>("getCookie", "allgem_rank");
            var moneyString = await JSRuntime.InvokeAsync<string>("getCookie", "acm");
            int.TryParse(moneyString, out Money);


            // Update the authentication state based on the cookie value
            if (CookieValue == "isli")
            {
                repository.SetLoggedIn(true);
            }
            else
            {
                repository.SetLoggedIn(false);
            }

            if (CookieValue1 == "hsp")
            {
                repository.SetHasPremium(true);
            }
            else
            {
                repository.SetHasPremium(false);
            }
            StateHasChanged();
            if (repository.IsLoggedIn)
            {
                dik = true;
                _ = RankosAsync();
            }
            else
            {
                dik = false;
            }
        }
    }
    private async Task Logout()
    {
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_auth");
        await JSRuntime.InvokeVoidAsync("deleteCookie", "allgem_premium");
        repository.SetLoggedIn(false);
        NavigationManager.NavigateTo("/");
    }

private async Task RankosAsync()
{
    if (CookieValueRank == "Silver")
    {
        repository.rankCount = 10;
    }
    else if (CookieValueRank == "Gold")
    {
        repository.rankCount = 20;
    }
    else if (CookieValueRank == "Platinum")
    {
        repository.rankCount = 30;
    }
    else if (CookieValueRank == "Diamond")
    {
        repository.rankCount = 40;
    }
    else
    {
        repository.rankCount = 0;
    }
    while (dik)
    {
        await Task.Delay(10000);
        repository.rankCount++;

        if (repository.rankCount == 10)
        {
            repository.AddRankToUser(CookieValueEmail, "Silver");
        }
        else if (repository.rankCount == 20)
        {
            repository.AddRankToUser(CookieValueEmail, "Gold");
        }
        else if (repository.rankCount == 30)
        {
            repository.AddRankToUser(CookieValueEmail, "Platinum");
        }
        else if (repository.rankCount == 40)
        {
            repository.AddRankToUser(CookieValueEmail, "Diamond");
        }
    }
}


