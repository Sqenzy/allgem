<header>
  @if (repository.IsLoggedIn)
    {
      
      @if (repository.hasPremium)
      {
        <img @onclick="homeFf" class="logopremium" src="/allgempremium.png" alt="ALLGEM PREMIUM">
        <img class="lpu">
      }
      else
      {
        <img @onclick="homeFf" class="logo" src="/allgemtext.png" alt="ALLGEM">   
      }
    }
    else
    {
      <img @onclick="homeFf" class="logo" src="/allgemtext.png" alt="ALLGEM">
    }
    <button class="mobileprofile" @onclick="MobileProfile" type="button">
      <img class="profileimg" src="/profile.png" alt="profile">
      </button>
    <nav>
    <li><button class="home" type="button" @onclick="homeFf">Casino</button></li>
    <li><button class="aboutus" type="button" @onclick="aboutusFf">About Us</button></li>
    <li><button class="contactus" type="button" @onclick="contactusFf">Contact Us</button></li>
@if (repository.IsLoggedIn)
