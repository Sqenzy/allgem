  @* .mines-game {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 30px;
    background: linear-gradient(135deg, #0f1419 0%, #1a2332 100%);
    border-radius: 20px;
    color: white;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    margin: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    width: 35vw;
    height: 80vh;
  } *@
  .game-grid {
    display: flex;
    background: rgba(0, 0, 0, 0.3);
    padding: 20px;
    height: 500px;
    width: 500px;
    border-radius: 20px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 4px 8px rgba(0, 0, 0, 0.3);
    justify-content: center;
    align-items: center;
  }
  .grid-row {
    display: contents;
  }
  .grid-tile {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #374151 0%, #1f2937 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
  }
  .grid-tile::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .grid-tile:hover::before {
    opacity: 1;
  }
  .grid-tile:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.3);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .grid-tile:active {
    transform: translateY(0);
  }
  .grid-tile.revealed {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border-color: rgba(255, 255, 255, 0.2);
    cursor: default;
    transform: none;
  }
  .grid-tile.revealed:hover {
    transform: none;
    box-shadow: none;
  }
  .grid-tile.revealed.mine {
    background: linear-gradient(135deg, #dc2626 0%, #991b1b 100%);
    border-color: #fca5a5;
    animation: explode 0.3s ease-out;
  }
  .grid-tile.revealed.diamond {
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    border-color: #6ee7b7;
    animation: sparkle 0.5s ease-out;
  }
  .mine {
    font-size: 32px;
    animation: bounce 0.5s ease-in-out;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
  }
  .diamond {
    font-size: 32px;
    animation: shine 0.5s ease-in-out;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.5));
  }
  .grid-tile.revealed.mine .mine {
    text-shadow: 0 0 10px #ff4444, 0 0 20px #ff4444, 0 0 30px #ff4444;
  }
  .grid-tile.revealed.diamond .diamond {
    text-shadow: 0 0 10px #00ff88, 0 0 20px #00ff88, 0 0 30px #00ff88;
  }
  /* Responsive design */
  @@media (max-width: 768px) {
    .game-grid {
      grid-template-columns: repeat(5, 60px);
      grid-template-rows: repeat(5, 60px);
