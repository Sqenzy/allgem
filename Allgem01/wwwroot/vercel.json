{
  "buildCommand": "dotnet publish -c Release",
  "outputDirectory": "bin/Release/net8.0/publish/wwwroot",
  "framework": "blazor",
  "installCommand": "",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/index.html" }
  ],
  "build": {
    "env": {
      "DOTNET_ROOT": "/usr/share/dotnet"
    }
  }
}